#!/usr/bin/env bash
# CT stub for `gh`: serves pull requests of the fixture owner `aq-fixture` from files in
# $CT_STUB_DIR and logs every argv line to $CT_STUB_DIR/gh.log. For PR <n> of <owner>/<repo> the
# files are pr-<owner>-<repo>-<n>.json (the `gh pr view` object), .patch (the diff), .files.json
# (the `gh api` files list), and the flags .escape (the diff refuses without
# --allow-escape-sequences, as cli/cli does) and .mergefail (a merge fails).
set -u
dir=${CT_STUB_DIR:?CT_STUB_DIR is not set}
printf '%s\n' "gh $*" >>"$dir/gh.log"
sub=${1:-}
verb=${2:-}
repo=""
fields=""
escape=0
n=""
args=("$@")
for ((i = 2; i < ${#args[@]}; i++)); do
  a=${args[i]}
  case $a in
    -R | --repo) repo=${args[i + 1]}; i=$((i + 1)) ;;
    --json) fields=${args[i + 1]}; i=$((i + 1)) ;;
    --allow-escape-sequences) escape=1 ;;
    --match-head-commit) i=$((i + 1)) ;;
    -*) ;;
    *) [ -z "$n" ] && n=$a ;;
  esac
done
base="$dir/pr-${repo//\//-}-$n"
if [ "$sub" = api ]; then
  for a in "$@"; do
    case $a in
      repos/*/pulls/*/files*)
        p=${a#repos/}
        r=${p%%/pulls/*}
        p=${p#*/pulls/}
        cat "$dir/pr-${r//\//-}-${p%%/*}.files.json"
        exit 0
        ;;
    esac
  done
  echo "stub: unsupported gh api call" >&2
  exit 1
fi
[ "$sub" = pr ] || { echo "stub: unsupported gh command: $sub" >&2; exit 1; }
[ -e "$base.json" ] || { echo "no pull requests found for $repo#$n" >&2; exit 1; }
case $verb in
  view)
    if [ -n "$fields" ]; then
      jq -c --arg f "$fields" '. as $o | ($f | split(",")) | map({key: ., value: $o[.]}) | from_entries' "$base.json"
    else
      jq -c . "$base.json"
    fi
    ;;
  diff)
    if [ -e "$base.escape" ] && [ "$escape" = 0 ]; then
      echo "the diff contains terminal escape sequences; pass --allow-escape-sequences to output it anyway" >&2
      exit 1
    fi
    cat "$base.patch"
    ;;
  merge)
    if [ -e "$base.mergefail" ]; then
      echo "stub: merge refused for $repo#$n" >&2
      exit 1
    fi
    jq -c '.state = "MERGED"' "$base.json" >"$base.json.tmp" && mv "$base.json.tmp" "$base.json"
    ;;
  *) echo "stub: unsupported gh pr verb: $verb" >&2; exit 1 ;;
esac
