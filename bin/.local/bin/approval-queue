#!/usr/bin/env bash
# approval-queue: put one item (a PR, a design, a triage list, a packet, a blueprint, a page, a change) in front
# of Geoff in the Design & PR Approvals app and print his decision as JSON on stdout. Build, server, and browser
# output go to server.log. `approval-queue approved [--kind page] <file> <blob>` answers whether the log holds
# an approve of that blob.
set -euo pipefail

usage="usage: approval-queue <pr|design|triage> <repo> <title> <source>
       approval-queue packet [--check] <initiative> <file>
       approval-queue blueprint <worktree> <title> <file> --description <file> [--notes <notes.json>] [--replies <replies.json>]
       approval-queue page <worktree> <title> <file> --pr <owner/repo#n> --description <file> [--notes <notes.json>] [--replies <replies.json>]
       approval-queue change <owner/repo#n> <title> [--notes <notes.json>] [--replies <replies.json>]
       approval-queue approved [--kind blueprint|page] <file> <blob>
       approval-queue withdraw <id>
       approval-queue collect <id>
       approval-queue anchors <file>"
root="${XDG_STATE_HOME:-$HOME/.local/state}/approval-queue"
id_pattern='^[0-9]{8}T[0-9]{6}-[0-9]+$'

# proc_stat <pid>: prints the process's state letter and its start time in clock ticks since boot (fields 3 and
# 22 of /proc/<pid>/stat), or fails when the process is gone. The command name in field 2 can hold spaces, so
# the text is split after the last `)`.
proc_stat() {
  local s
  read -r s <"/proc/$1/stat" 2>/dev/null || return 1
  s=${s##*) }
  set -- $s
  echo "$1 ${20}"
}

# proc_running <pid> <start>: succeeds when the pid is a live process that started at <start>. A reused pid has
# another start time, and a killed command its parent has not reaped is a zombie.
proc_running() {
  local st
  st=$(proc_stat "$1") || return 1
  [ "${st% *}" != Z ] && [ "${st#* }" = "$2" ]
}

# withdraw <id>: takes a waiting item off the board. A live waiter gets TERM, and its exit trap removes
# item.json; a dead or deferred waiter leaves the file for withdraw to remove.
if [ "${1:-}" = withdraw ]; then
  shift
  if [ $# -ne 1 ]; then echo "$usage" >&2; exit 2; fi
  wdir="$root/items/$1"
  if [[ ! $1 =~ $id_pattern ]]; then echo "approval-queue: $1 is not an item id" >&2; exit 2; fi
  if [ ! -e "$wdir/item.json" ]; then echo "approval-queue: no item $1 is queued" >&2; exit 2; fi
  if [ -e "$wdir/decision.json" ]; then echo "approval-queue: $1 is decided; collect it instead" >&2; exit 2; fi
  wpid=$(jq -r '.pid // empty' "$wdir/item.json")
  wstart=$(jq -r '.pidStart // empty' "$wdir/item.json")
  if [ -z "$wpid" ]; then echo "approval-queue: $1 was queued before withdraw existed; stop its command" >&2; exit 2; fi
  if [ -e "$wdir/deferred.json" ] || ! proc_running "$wpid" "$wstart"; then
    rm -f "$wdir/item.json" "$wdir/item.json.tmp"
    exit 0
  fi
  kill -TERM "$wpid" 2>/dev/null || true
  for _ in $(seq 50); do
    [ -e "$wdir/item.json" ] || exit 0
    sleep 0.1
  done
  if [ -e "$wdir/decision.json" ]; then
    echo "approval-queue: $1 was decided while withdrawing; run collect" >&2
  else
    echo "approval-queue: $1 is still queued after its command was told to stop" >&2
  fi
  exit 1
fi

# approved [--kind blueprint|page] <file> <blob>: exit 0 when decisions.jsonl holds an approve of the given
# kind (blueprint unless --kind says page) whose ref names <file> after the repo and whose blob is <blob>,
# else 1. A line that does not parse is skipped.
if [ "${1:-}" = approved ]; then
  shift
  akind=blueprint
  if [ "${1:-}" = --kind ]; then
    [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }
    akind=$2
    shift 2
  fi
  case "$akind" in blueprint | page) ;; *) echo "$usage" >&2; exit 2 ;; esac
  if [ $# -ne 2 ]; then echo "$usage" >&2; exit 2; fi
  [ -e "$root/decisions.jsonl" ] || exit 1
  jq -R -n -e --arg f "${1#./}" --arg b "$2" --arg k "$akind" '
    any(inputs | fromjson? | objects;
      .kind == $k and .verdict == "approve" and .blob == $b
      and ((.ref // "") | tostring | sub("^[^:]*:"; "") | ltrimstr("./")) == $f)' "$root/decisions.jsonl" >/dev/null \
    && exit 0
  exit 1
fi

collecting="" check="" initiative="" repo="" title="" source="" worktree="" notes="" replies="" description="" pr="" pr_repo="" number="" prhead=""
if [ "${1:-}" = blueprint ] || [ "${1:-}" = page ] || [ "${1:-}" = change ]; then
  kind=$1
  shift
  args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --notes) [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; notes=$2; shift 2 ;;
      --replies) [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; replies=$2; shift 2 ;;
      --description) [ "$kind" != change ] && [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; description=$2; shift 2 ;;
      --pr) [ "$kind" = page ] && [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; pr=$2; shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  if [ "$kind" = change ]; then
    if [ "${#args[@]}" -ne 2 ]; then echo "$usage" >&2; exit 2; fi
    pr=${args[0]} title=${args[1]}
  else
    if [ "${#args[@]}" -ne 3 ] || { [ "$kind" = page ] && [ -z "$pr" ]; }; then echo "$usage" >&2; exit 2; fi
    worktree=${args[0]} title=${args[1]} source=${args[2]#./}
  fi
  if [ -n "$pr" ]; then
    if [[ ! $pr =~ ^([A-Za-z0-9._-]+/[A-Za-z0-9._-]+)#([0-9]+)$ ]]; then
      echo "approval-queue: give the pull request as owner/repo#n, not $pr" >&2; exit 2
    fi
    pr_repo=${BASH_REMATCH[1]} number=${BASH_REMATCH[2]}
  fi
elif [ "${1:-}" = collect ]; then
  shift
  if [ $# -ne 1 ]; then echo "$usage" >&2; exit 2; fi
  if [[ ! $1 =~ $id_pattern ]]; then echo "approval-queue: $1 is not an item id" >&2; exit 2; fi
  if [ ! -e "$root/items/$1/item.json" ]; then echo "approval-queue: no item $1 is queued" >&2; exit 2; fi
  kind=collect collecting=$1
elif [ "${1:-}" = anchors ]; then
  shift
  if [ $# -ne 1 ]; then echo "$usage" >&2; exit 2; fi
  kind=anchors source=$1
elif [ "${1:-}" = packet ]; then
  shift
  if [ "${1:-}" = --check ]; then check=1; shift; fi
  if [ $# -ne 2 ]; then echo "$usage" >&2; exit 2; fi
  kind=packet initiative=$1 source=$2
else
  if [ $# -ne 4 ]; then echo "$usage" >&2; exit 2; fi
  kind=$1 repo=$2 title=$3 source=$4
  case "$kind" in pr | design | triage) ;; *) echo "$usage" >&2; exit 2 ;; esac
fi

log="$root/server.log"
id="$(date +%Y%m%dT%H%M%S)-$$"
[ -z "$collecting" ] || id=$collecting
item="$root/items/$id"
# The pid and its start time let the board and `withdraw` tell this command from a process that reused its pid.
pidstart=$(proc_stat "$$" | cut -d' ' -f2)
fetch="$root/fetch-$id"
# The port is fixed when the app is built, so a running app serves only the port it was built with.
port="${APPROVAL_QUEUE_PORT:-7907}"
base="http://127.0.0.1:$port"
projects="${APPROVAL_QUEUE_PROJECTS:-$HOME/Projects}"
mkdir -p "$root"
: >>"$log"

# A command that leaves without a decision takes its item off the index, unless Geoff deferred it: a deferred
# item stays on the board with no waiter.
if [ -n "$collecting" ]; then
  # A collect never takes the item off the board, however it ends.
  trap 'rm -f "$check_body" "$check_err"; rm -rf "$fetch"' EXIT
else
  trap '[ -e "$item/decision.json" ] || [ -e "$item/deferred.json" ] || rm -f "$item/item.json" "$item/item.json.tmp"; rm -f "$check_body" "$check_err"; rm -rf "$fetch"' EXIT
fi
trap 'exit 143' TERM HUP INT

app=$(realpath "$(dirname "$(realpath "$0")")/../../../approval-queue")
# One pair per invocation: a PR hand-over and a triage hand-over run side by side.
check_body="$root/check-$id.md"
check_err="$root/check-$id.err"

# anchors <file>: prints the file's heading anchors, slugged as cairn's pages are. The entry needs the app's
# node_modules.
if [ "${kind:-}" = anchors ]; then
  exec node "$app/src/anchors.ts" "$source"
fi

# check_brief <file>: refuses (exit 2) an item whose brief is missing or incomplete, before any
# item directory exists, and sets headline. Anything else that fails is a tool failure (exit 1).
headline=""
check_brief() {
  local out rc=0
  out=$(node "$app/src/check-brief.ts" "$kind" "$1" 2>"$check_err") || rc=$?
  if [ "$rc" -ne 0 ]; then
    cat "$check_err" >&2
    [ "$rc" -eq 2 ] || echo "approval-queue: the brief check failed to run" >&2
    exit "$((rc == 2 ? 2 : 1))"
  fi
  headline=$(jq -r '.headline' <<<"$out")
}

# pr_diff <owner/repo> <n> <file>: saves PR n's diff into file. GitHub refuses a diff of more than
# 300 files (HTTP 406, too_large), so that one refusal falls back to the PR's file list, which
# carries each file's patch for up to 3,000 files. A rename with no content change has no patch.
pr_diff() {
  local r=$1 n=$2 out=$3 err
  if err=$(gh pr diff "$n" -R "$r" 2>&1 >"$out" </dev/null); then return 0; fi
  case $err in
    *too_large*) ;;
    *) printf '%s\n' "$err" >&2; return 1 ;;
  esac
  gh api --paginate "repos/$r/pulls/$n/files?per_page=100" </dev/null | jq -rs '
    add | .[] | (.previous_filename // .filename) as $old
    | "diff --git a/\($old) b/\(.filename)",
      (if .status == "renamed" then "rename from \($old)", "rename to \(.filename)" else empty end),
      (if .patch then "--- a/\($old)", "+++ b/\(.filename)", .patch else empty end)' >"$out"
}

# fetch_pr <dir> <owner/repo> <n>: saves PR n's metadata, body, and diff into dir. The diff must be
# the diff of the head the decision pins, so a head that moved while fetching is fetched again, and
# a third move exits 1.
fetch_pr() {
  local d=$1 r=$2 n=$3 view again try
  mkdir -p "$d"
  for try in 1 2 3; do
    view=$(gh pr view "$n" -R "$r" --json body,headRefOid,number,url,headRefName,baseRefName,statusCheckRollup,state </dev/null)
    pr_diff "$r" "$n" "$d/diff.patch"
    again=$(gh pr view "$n" -R "$r" --json headRefOid </dev/null | jq -r '.headRefOid')
    if [ "$again" = "$(jq -r '.headRefOid' <<<"$view")" ]; then
      jq -r '.body' <<<"$view" >"$d/body.md"
      jq --arg ref "$r#$n" '{ref: $ref, head: .headRefOid} + del(.body, .headRefOid)' <<<"$view" >"$d/pr.json"
      return 0
    fi
  done
  echo "approval-queue: $r#$n moved its head three times while it was fetched; try again" >&2
  exit 1
}

register='~/.claude/docs/voice/approval-brief.md'

# refuse_packet <defect>: prints the defect, logs {time, initiative, defect} to refusals.jsonl, exit 2.
refuse_packet() {
  printf '%s\n' "$1" >&2
  jq -nc --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg i "$initiative" --arg d "$1" \
    '{time: $t, initiative: $i, defect: $d}' >>"$root/refusals.jsonl"
  exit 2
}

# check_description: refuses (exit 2) a blueprint or page with no --description file, or one whose title or
# paragraphs break the register's rules, before any item directory exists.
check_description() {
  local rc=0
  if [ -z "$description" ]; then
    echo "approval-queue: $kind needs --description <file>: two or three paragraphs, a background paragraph and then one or two summary paragraphs, that the page shows under the title (see the README's \"The description\" section)" >&2
    exit 2
  fi
  if [ ! -f "$description" ]; then echo "approval-queue: no description file at $description" >&2; exit 2; fi
  node "$app/src/check-brief.ts" description "$description" "$title" >/dev/null 2>"$check_err" || rc=$?
  if [ "$rc" -ne 0 ]; then
    cat "$check_err" >&2
    [ "$rc" -eq 2 ] || echo "approval-queue: the description check failed to run" >&2
    exit "$((rc == 2 ? 2 : 1))"
  fi
}

# The revision lookup. Given $refs, an array of {ref, kind}, it prints null, or {item, revision, parts} when
# one or more refs are sent back. A ref is sent back when its latest log line (a line that does not parse is
# skipped) is a reject that counts. A reject counts unless Geoff marked that part approve inside a packet where he
# sent another part back: its `sentBack` is false and a line of its packet says true. A line with no `sentBack`
# (written before the field), and the lines of a note-only send-back, count. `item` is the packet id of the latest
# such line and `revision` is one more than the number of distinct packet ids among the counting reject lines
# naming any ref after that ref's latest approve. `parts` holds the head or sha256 of each sent-back ref's reject
# line in that item.
revision_program=$(cat <<'JQ'
[inputs | fromjson? | objects] as $L
| ($L | to_entries) as $E
| def lines($r): [$E[] | select(.value.ref == $r.ref and .value.kind == $r.kind)];
  def counts($l): $l.sentBack != false or (any($L[]; .packet == $l.packet and .sentBack == true) | not);
  [$refs[] | . as $r | (lines($r) | last) as $last
   | select($last != null and $last.value.verdict == "reject" and counts($last.value))
   | {ref: $r.ref, at: $last.key, item: $last.value.packet}] as $sent
| if ($sent | length) == 0 then null
  else
    ($sent | max_by(.at)) as $latest
    | {item: $latest.item,
       revision: (1 + ([$refs[] | . as $r | lines($r) as $mine
           | (([$mine[] | select(.value.verdict == "approve") | .key] | last) // -1) as $ap
           | $mine[] | select(.value.verdict == "reject" and .key > $ap and counts(.value)) | .value.packet] | unique | length)),
       parts: [$sent[] | select(.item == $latest.item) | $L[.at] as $l
           | {ref: .ref} + (if $l.head then {head: $l.head} elif $l.sha256 then {sha256: $l.sha256} else {} end)]}
  end
JQ
)

# revision_of <refs json>: prints the lookup's answer, null when nothing is sent back or no log exists yet.
revision_of() {
  [ -e "$root/decisions.jsonl" ] || { echo null; return 0; }
  jq -R -n -c --argjson refs "$1" "$revision_program" "$root/decisions.jsonl"
}

# amend_of <ref> <kind>: prints the blob of the latest approve of the document, or nothing when the log holds
# none. A queue of the document after an approve is an amend review of what changed since that blob. A line that
# does not parse is skipped.
amend_of() {
  [ -e "$root/decisions.jsonl" ] || return 0
  jq -R -n -r --arg ref "$1" --arg k "$2" '
    [inputs | fromjson? | objects | select(.kind == $k and .verdict == "approve" and .ref == $ref and (.blob | type) == "string")]
    | (last // {}) | .blob // empty' "$root/decisions.jsonl"
}

# waiting_item <ref>: prints the id of a waiting item (one with an item.json and no decision.json)
# that holds the PR, whether a packet part, a pr-kind item, or a change.
waiting_item() {
  local f
  for f in "$root"/items/*/item.json; do
    [ -e "$f" ] && [ ! -e "$(dirname "$f")/decision.json" ] || continue
    jq -r --arg ref "$1" 'select((.kind == "packet" and (.refs | index($ref)))
      or ((.kind == "pr" or .kind == "change") and "\(.repo)#\(.number)" == $ref)) | .id' "$f"
  done | head -n 1
}

# since_diff <dir> <owner/repo> <old head> <new head>: for a part whose head moved since Geoff sent it back,
# saves what changed since as since.patch when the old head is still behind the new one, and as since.json
# {"gone": true} when it is not (a force-push: GitHub answers another status, 404, or 422). A diff too large to
# serve (406) saves neither, so the part shows its full list; any other gh failure is a tool failure.
since_diff() {
  local d=$1 r=$2 old=$3 new=$4 status err
  [ "$old" != "$new" ] || return 0
  if status=$(gh api "repos/$r/compare/$old...$new" --jq '.status' 2>"$check_err" </dev/null); then
    if [ "$status" = ahead ]; then
      if err=$(gh api -H 'Accept: application/vnd.github.diff' "repos/$r/compare/$old...$new" 2>&1 >"$d/since.patch" </dev/null); then return 0; fi
      rm -f "$d/since.patch"
      case $err in *406*) return 0 ;; esac
      printf '%s\n' "$err" >&2
      exit 1
    fi
    echo '{"gone": true}' >"$d/since.json"
    return 0
  fi
  case $(cat "$check_err") in
    *404* | *422*) echo '{"gone": true}' >"$d/since.json" ;;
    *) cat "$check_err" >&2; exit 1 ;;
  esac
}

# queue_packet: parses the packet, fetches every part under the queue lock, checks the PR data, and
# writes the item directory, item.json last. With --check it stops before writing anything. Sets
# repo and leaves the lock released.
queue_packet() {
  local rc=0 k kind_k owner_k repo_k number_k path_k headline initiative_title="" ref st other old revises defects=()
  if [ "$initiative" != none ]; then
    [[ $initiative =~ ^[a-z0-9-]+$ && -e "$projects/initiatives/$initiative/initiative.yaml" ]] \
      || refuse_packet "the initiative is none or the id of a record: no initiatives/$initiative/initiative.yaml under $projects ($register)"
    initiative_title=$(sed -nE '/^title:/{s/^title:[[:space:]]*//;s/[[:space:]]+$//;s/^"(.*)"$/\1/;s/^'"'"'(.*)'"'"'$/\1/;p;q}' \
      "$projects/initiatives/$initiative/initiative.yaml")
  fi
  node "$app/src/check-brief.ts" packet "$source" >"$fetch.json" 2>"$check_err" || rc=$?
  if [ "$rc" -ne 0 ]; then
    [ "$rc" -eq 2 ] && refuse_packet "$(cat "$check_err")"
    cat "$check_err" >&2
    echo "approval-queue: the packet check failed to run" >&2
    exit 1
  fi
  mkdir -p "$fetch/parts"
  mv "$fetch.json" "$fetch/packet.json"
  revises=$(revision_of "$(jq -c '[.parts[].part | select(.kind == "pr" or .kind == "design") | {ref, kind}]' "$fetch/packet.json")")
  if [ "$revises" != null ] && ! jq -e '.whatChanged' "$fetch/packet.json" >/dev/null; then
    refuse_packet "this packet resends $(jq -r '[.parts[].ref] | join(", ")' <<<"$revises") that you sent back in the item $(jq -r '.item' <<<"$revises"); add a \`## What changed\` section of bullets saying what changed ($register)"
  elif [ "$revises" = null ] && jq -e '.whatChanged' "$fetch/packet.json" >/dev/null; then
    refuse_packet "\`## What changed\` is for a packet that resends a part you sent back, and no part of this packet was sent back (a part you marked approve inside a rejected packet was not); drop the section ($register)"
  fi
  exec 8>"$root/queue.lock"
  flock 8
  while IFS=$'\x1f' read -r k kind_k owner_k repo_k number_k path_k; do
    case "$kind_k" in
      pr) fetch_pr "$fetch/parts/$k" "$owner_k/$repo_k" "$number_k" ;;
      design)
        mkdir -p "$fetch/parts/$k"
        cp "$projects/$repo_k/$path_k" "$fetch/parts/$k/doc.md"
        jq -n --arg path "$path_k" --arg sha "$(sha256sum "$fetch/parts/$k/doc.md" | cut -d' ' -f1)" \
          '{path: $path, sha256: $sha}' >"$fetch/parts/$k/doc.json"
        ;;
    esac
  done < <(jq -r '.parts | to_entries[] | .value.part as $p
    | [.key, $p.kind, ($p.owner // ""), ($p.repo // ""), ($p.number // "" | tostring), ($p.path // "")] | join("\u001f")' "$fetch/packet.json")
  while IFS=$'\x1f' read -r k ref; do
    st=$(node "$app/src/check-pr.ts" "$fetch/parts/$k/pr.json" "$fetch/parts/$k/body.md") \
      || { echo "approval-queue: the PR check failed to run for $ref" >&2; exit 1; }
    if [ "$(jq -r '.state' <<<"$st")" != OPEN ]; then
      defects+=("$ref is $(jq -r '.state' <<<"$st"); a merged or closed PR cannot be queued")
      continue
    fi
    other=$(waiting_item "$ref")
    [ -z "$other" ] || { defects+=("$ref is already in the waiting item $other; decide it first"); continue; }
    if [ "$(jq -r '.pending' <<<"$st")" -gt 0 ]; then
      defects+=("$ref has checks still pending; wait for the checks to finish")
      continue
    fi
    if jq -e '(.failed | length) > 0 or .verdict == "fix" or .verdict == "escalate"' <<<"$st" >/dev/null \
      && ! jq -e --arg r "$ref" 'any(.asks[]; .rule == "gate-failed" and .part.ref == $r)' "$fetch/packet.json" >/dev/null; then
      defects+=("$ref has a failing check or a review verdict of fix or escalate; a failing gate is an ask with the rule gate-failed naming it")
    fi
    if jq -e '.beforeMerge' <<<"$st" >/dev/null \
      && ! jq -e --arg r "$ref" 'any(.asks[]; .part.ref == $r)' "$fetch/packet.json" >/dev/null; then
      defects+=("$ref has a Before merge section; a Before merge step is an ask naming the PR")
    fi
  done < <(jq -r '.parts | to_entries[] | select(.value.part.kind == "pr") | [.key, .value.part.ref] | join("\u001f")' "$fetch/packet.json")
  if [ "${#defects[@]}" -gt 0 ]; then
    refuse_packet "$(printf '%s\n' "${defects[@]}") (see $register)"
  fi
  if [ -n "$check" ]; then exit 0; fi
  if [ "$revises" != null ]; then
    while IFS=$'\x1f' read -r k owner_k repo_k old; do
      since_diff "$fetch/parts/$k" "$owner_k/$repo_k" "$old" "$(jq -r '.head' "$fetch/parts/$k/pr.json")"
    done < <(jq -r --argjson r "$revises" '.parts | to_entries[] | select(.value.part.kind == "pr") | .key as $k | .value.part as $p
      | $r.parts[] | select(.ref == $p.ref and .head != null) | [$k, $p.owner, $p.repo, .head] | join("\u001f")' "$fetch/packet.json")
  fi
  headline=$(jq -r '.headline' "$fetch/packet.json")
  repo=$(jq -r '[.parts[].part | select(.kind != "step")][0] | "\(.owner)/\(.repo)"' "$fetch/packet.json")
  mkdir -p "$item"
  cp "$source" "$item/packet.md"
  mv "$fetch/packet.json" "$item/packet.json"
  mv "$fetch/parts" "$item/parts"
  jq -n --arg id "$id" --arg initiative "$initiative" --arg ititle "$initiative_title" --arg repo "$repo" --arg headline "$headline" \
    --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --slurpfile packet "$item/packet.json" --argjson revises "$revises" \
    --argjson pid "$$" --argjson pidstart "$pidstart" \
    '{id: $id, kind: "packet", initiative: $initiative, initiativeTitle: $ititle, repo: $repo, title: $headline, created: $created,
      headline: $headline, refs: [$packet[0].parts[].part.ref], pid: $pid, pidStart: $pidstart} + (if $revises == null then {} else {revises: $revises} end)' >"$item/item.json.tmp"
  mv "$item/item.json.tmp" "$item/item.json"
  exec 8>&-
}

# The shape blueprint-notes.json sets: each note's fields and types, the kinds, and unique ids. Prints one
# defect per line, so a refusal names every problem at once. With --argjson change true, a note also names
# its document in `file`, and a choice rewrites nothing, since a change review takes no edits.
notes_program=$(cat <<'JQ'
def str: type == "string";
def fields: ["id", "kind", "anchor", "title", "body", "was", "now", "sides", "choices"] + (if $change then ["file"] else [] end);
def opt($k; f): (has($k) | not) or (.[$k] | f);
def opt_in($o; $k): ($o | has($k) | not) or ($o[$k] | str);
def name($i): "note \($i + 1)" + (if (.id? | type) == "string" then " (\(.id))" else "" end);
# An anchor is a non-empty string, or (on a blueprint or page) an object quoting the text: a non-empty quote
# and an optional prefix and suffix, which tell apart a quote that occurs more than once.
def anchor_defects($n):
  .anchor as $a
  | if ($a | type) == "string" then (if $a == "" then "\($n) needs an anchor string" else empty end)
    elif ($a | type) == "object" then
      if $change then "\($n) is a change note, which takes an anchor string, not a quote object"
      else
        (if ($a.quote | str) and $a.quote != "" then empty else "\($n) needs an anchor quote that is a non-empty string" end),
        (if opt_in($a; "prefix") then empty else "\($n) has an anchor prefix that is not a string" end),
        (if opt_in($a; "suffix") then empty else "\($n) has an anchor suffix that is not a string" end),
        ((($a | keys) - ["quote", "prefix", "suffix"])[] | "\($n) has an unknown anchor key \(.)")
      end
    else "\($n) needs an anchor string" end;
if type != "array" then "the file must hold a JSON array of notes"
else
  (to_entries[] | .key as $i | .value
   | if type != "object" then "note \($i + 1) is not an object"
     else name($i) as $n
     | ((keys - fields)[] | "\($n) has an unknown field \(.)"),
       (if $change and (((.file | str) and .file != "") | not) then "\($n) needs a file string naming a changed document" else empty end),
       (if $change and any((.choices // [])[]?; type == "object" and (has("text") or has("edit")))
        then "\($n) has a choice with text or edit; a change review takes no edits" else empty end),
       (if (.id | str) and .id != "" then empty else "\($n) needs an id string" end),
       (if .kind | IN("info", "decide", "question") then empty else "\($n) has kind \(.kind | tojson); kind is info, decide, or question" end),
       anchor_defects($n),
       (if .title | str then empty else "\($n) needs a title string" end),
       (if (.body | type) == "array" and all(.body[]; str) then empty else "\($n) needs a body that is an array of strings" end),
       (if opt("was"; str) and opt("now"; str) then empty else "\($n) has a was or now that is not a string" end),
       (if has("was") == has("now") then empty else "\($n) has one of was and now without the other" end),
       (if opt("sides"; type == "array" and all(.[]; type == "object" and (.who | str) and (.text | str))) then empty
        else "\($n) needs sides as an array of {who, text} strings" end),
       (if opt("choices"; type == "array" and all(.[]; type == "object" and (.label | str) and (.done | str)
            and opt("text"; str) and opt("edit"; type == "boolean")
            and ((keys - ["label", "text", "done", "edit"]) | length == 0))) then empty
        else "\($n) needs choices as an array of {label, text?, done, edit?}" end),
       (if .kind == "info" or ((.choices | type) == "array" and (.choices | length) > 0) then empty
        else "\($n) is a \(.kind) note with no choices, so it could never be answered" end)
     end),
  ([.[] | objects | .id | strings] | group_by(.)[] | select(length > 1) | "the id \(.[0] | tojson) is used \(length) times")
end
JQ
)

# check_notes: refuses (exit 2) a notes file that does not match the notes shape. A change's notes also
# name a document each.
change_notes=false
check_notes() {
  local defects
  [ -n "$notes" ] || return 0
  if [ ! -f "$notes" ]; then echo "approval-queue: no notes file at $notes" >&2; exit 2; fi
  if ! defects=$(jq -r --argjson change "$change_notes" "$notes_program" "$notes" 2>/dev/null); then
    echo "approval-queue: $notes is not JSON" >&2; exit 2
  fi
  if [ -n "$defects" ]; then
    printf 'approval-queue: %s does not match the notes shape (see blueprint-notes.json):\n' "$notes" >&2
    printf '  %s\n' "$defects" >&2
    exit 2
  fi
}

# The shape of a --replies file: an array of threads, each the original comment's id, quote, and anchor with
# the author's status and reply text, as `Thread` in approval-queue/src/lib/editor/comments.ts sets it. Prints
# one defect per line. With --argjson change true, each anchor names its document in `file`; otherwise it names
# none.
replies_program=$(cat <<'JQ'
def str: type == "string";
def whole: type == "number" and . >= 0 and . == floor;
def name($i): "thread \($i + 1)" + (if (.id? | type) == "string" then " (\(.id))" else "" end);
if type != "array" then "the file must hold a JSON array of threads"
else
  (to_entries[] | .key as $i | .value
   | if type != "object" then "thread \($i + 1) is not an object"
     else name($i) as $n
     | ((keys - ["id", "status", "text", "quote", "anchor"])[] | "\($n) has an unknown field \(.)"),
       (if (.id | str) and .id != "" then empty else "\($n) needs an id string" end),
       (if .status | IN("done", "kept", "answered") then empty
        else "\($n) has status \(.status | tojson); status is done, kept, or answered" end),
       (if .text | str then empty else "\($n) needs a text string" end),
       (if (.quote | str) and .quote != "" then empty else "\($n) needs a quote string" end),
       (if (.anchor | type) != "object" then "\($n) needs an anchor object"
        else .anchor
        | ((keys - ["quote", "prefix", "suffix", "from", "to", "commit", "file"])[] | "\($n) has an unknown anchor field \(.)"),
          (if (.quote | str) and (.prefix | str) and (.suffix | str) and (.commit | str) then empty
           else "\($n) needs an anchor with quote, prefix, suffix, and commit strings" end),
          (if (.from | whole) and (.to | whole) and .from < .to then empty
           else "\($n) needs an anchor whose from and to are whole numbers, from before to" end),
          (if $change then (if (.file | str) and .file != "" then empty else "\($n) needs an anchor file naming a changed document" end)
           elif has("file") then "\($n) has an anchor file; only a change's threads name one"
           else empty end)
        end)
     end),
  ([.[] | objects | .id | strings] | group_by(.)[] | select(length > 1) | "the id \(.[0] | tojson) is used \(length) times")
end
JQ
)

# check_replies: refuses (exit 2) a --replies file that does not match the thread shape. A change's threads
# also name a document each.
check_replies() {
  local defects
  [ -n "$replies" ] || return 0
  if [ ! -f "$replies" ]; then echo "approval-queue: no replies file at $replies" >&2; exit 2; fi
  if ! defects=$(jq -r --argjson change "$change_notes" "$replies_program" "$replies" 2>/dev/null); then
    echo "approval-queue: $replies is not JSON" >&2; exit 2
  fi
  if [ -n "$defects" ]; then
    printf 'approval-queue: %s does not match the replies shape (see the README'"'"'s Comments and replies):\n' "$replies" >&2
    printf '  %s\n' "$defects" >&2
    exit 2
  fi
}

# check_blueprint: refuses (exit 2) a worktree that is not a git worktree's top, a file that is not a regular
# file committed there or has uncommitted changes, and a notes or replies file that does not match its shape. Sets
# worktree to its absolute path, repo to the repository's name, and blob to the file's blob at HEAD.
blob=""
check_blueprint() {
  local top common entry
  check_description
  if ! top=$(git -C "$worktree" rev-parse --show-toplevel 2>/dev/null); then
    echo "approval-queue: $worktree is not a git worktree" >&2; exit 2
  fi
  if [ "$(cd "$worktree" && pwd -P)" != "$(cd "$top" && pwd -P)" ]; then
    echo "approval-queue: $worktree is inside a worktree; give the worktree's top, $top" >&2; exit 2
  fi
  worktree=$(cd "$top" && pwd -P)
  case "$source" in
    /* | ../* | */../* | "") echo "approval-queue: give the file as a path inside the worktree, not $source" >&2; exit 2 ;;
  esac
  if ! blob=$(git -C "$worktree" rev-parse --verify --quiet "HEAD:$source"); then
    echo "approval-queue: $source is not committed in $worktree; commit it first" >&2; exit 2
  fi
  # Mode 100644 is a regular file; a tree or a symlink has no text to review.
  entry=$(git -C "$worktree" ls-tree HEAD -- "$source")
  if [ "$entry" != "$(printf '100644 blob %s\t%s' "$blob" "$source")" ]; then
    echo "approval-queue: $source is not a regular file at HEAD in $worktree" >&2; exit 2
  fi
  if ! git -C "$worktree" diff --quiet HEAD -- "$source"; then
    echo "approval-queue: $source has uncommitted changes in $worktree; commit them first" >&2; exit 2
  fi
  check_notes
  check_replies
  common=$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)
  repo=$(basename "$(dirname "$common")")
}

# check_origin: refuses (exit 2) a page whose --pr names a repository other than the worktree's origin, so
# the approval can never name a pull request the reviewed file does not belong to.
check_origin() {
  local url slug
  if ! url=$(git -C "$worktree" remote get-url origin 2>/dev/null); then
    echo "approval-queue: $worktree has no origin remote to match $pr against" >&2; exit 2
  fi
  slug=$(sed -E 's#^(https://github\.com/|ssh://git@github\.com/|git@github\.com:)##; s#/$##; s#\.git$##' <<<"$url")
  if [ "${slug,,}" != "${pr_repo,,}" ]; then
    echo "approval-queue: $pr is not in $worktree's repository, whose origin is $url" >&2; exit 2
  fi
}

# pr_head <owner/repo> <n>: prints the PR's head commit, asking three times; returns 1 when gh cannot say.
pr_head() {
  local out try
  for try in 1 2 3; do
    if out=$(gh pr view "$2" -R "$1" --json headRefOid </dev/null 2>/dev/null) && out=$(jq -er '.headRefOid' <<<"$out" 2>/dev/null); then
      printf '%s\n' "$out"
      return 0
    fi
    sleep 1
  done
  return 1
}

# head_unmoved <queued head>: refuses an approve (exit 1, nothing logged) when the PR's head is no longer the
# head the item was queued at and the screen showed, since the approval would name commits Geoff never saw.
head_unmoved() {
  local now
  now=$(pr_head "$pr_repo" "$number") \
    || { echo "approval-queue: could not read the head of $pr to check it against $1; nothing was logged" >&2; exit 1; }
  if [ "$now" != "$1" ]; then
    echo "approval-queue: $pr moved from $1 to $now while it waited, so the approval does not cover it; nothing was logged; queue it again" >&2
    exit 1
  fi
}

# doc_kind <path>: prints blueprint or page for a path a change review shows as a document, else nothing. A
# blueprint is a *.blueprint.md, .yaml, or .yml file under blueprints/; a page is a Markdown file under
# docs/ other than docs/internal/.
doc_kind() {
  case "$1" in
    blueprints/*.blueprint.md | blueprints/*.blueprint.yaml | blueprints/*.blueprint.yml) echo blueprint ;;
    docs/internal/*) ;;
    docs/*.md | docs/*.mdx) echo page ;;
  esac
}

# gh_file <owner/repo> <path> <sha>: prints the file at that commit. Returns 3 when GitHub says it does not
# exist there, and 1 for any other failure. Each path segment is URI-encoded, so a path that holds `?` or `&`
# cannot name another file or commit.
gh_file() {
  local err enc
  enc=$(jq -rn --arg p "$2" --arg r "$3" '"\($p | split("/") | map(@uri) | join("/"))?ref=\($r | @uri)"')
  if err=$(gh api -H 'Accept: application/vnd.github.raw+json' "repos/$1/contents/$enc" 2>&1 >"$fetch.file" </dev/null); then
    cat "$fetch.file"; rm -f "$fetch.file"; return 0
  fi
  rm -f "$fetch.file"
  case $err in *"404"*) return 3 ;; esac
  printf '%s\n' "$err" >&2
  return 1
}

# changed_paths <diff>: prints the path each file of a git diff has after the change, one per line. A path git
# quotes (one with a control or non-ASCII byte) is skipped, and so is a header whose two paths differ: a
# rename is read from its `rename to` line instead.
changed_paths() {
  awk '
    /^diff --git / {
      r = substr($0, 12)
      if (substr(r, 1, 1) == "\"" || (length(r) - 5) % 2) next
      n = (length(r) - 5) / 2
      p = substr(r, 3, n)
      if (substr(r, 1, 2) == "a/" && substr(r, 3 + n, 3) == " b/" && substr(r, 6 + n) == p) print p
      next
    }
    /^rename to / { if (substr($0, 11, 1) != "\"") print substr($0, 11) }' "$1"
}

# queue_change: fetches the PR, then every changed blueprint and page at the merge base and the head, checks
# the notes against them, and writes the item directory under the queue lock, item.json last. Sets repo to
# the PR's owner/repo, head to its head commit, and leaves the lock released.
queue_change() {
  local tip base_sha path dk k=0 rc docs='[]' other unnamed
  repo=${pr_repo}
  change_notes=true
  check_notes
  check_replies
  fetch_pr "$fetch/pr" "$repo" "$number"
  head=$(jq -r '.head' "$fetch/pr/pr.json")
  tip=$(gh pr view "$number" -R "$repo" --json baseRefOid </dev/null | jq -er '.baseRefOid') \
    || { echo "approval-queue: could not read the base of $pr" >&2; exit 1; }
  # The merge base, not the base branch's tip, so edits main gained after the branch was cut never read as the change's.
  base_sha=$(gh api "repos/$repo/compare/$tip...$head" --jq '.merge_base_commit.sha' </dev/null) && [ -n "$base_sha" ] \
    || { echo "approval-queue: could not read the merge base of $pr" >&2; exit 1; }
  while IFS= read -r path; do
    dk=$(doc_kind "$path")
    [ -n "$dk" ] || continue
    mkdir -p "$fetch/docs/$k"
    rc=0
    gh_file "$repo" "$path" "$head" >"$fetch/docs/$k/new.md" || rc=$?
    if [ "$rc" -eq 3 ]; then rm -rf "$fetch/docs/$k"; continue; fi
    [ "$rc" -eq 0 ] || { echo "approval-queue: could not read $path at $head" >&2; exit 1; }
    rc=0
    gh_file "$repo" "$path" "$base_sha" >"$fetch/docs/$k/old.md" || rc=$?
    if [ "$rc" -eq 3 ]; then : >"$fetch/docs/$k/old.md"; elif [ "$rc" -ne 0 ]; then
      echo "approval-queue: could not read $path at $base_sha" >&2; exit 1
    fi
    docs=$(jq -c --arg p "$path" --arg k "$dk" '. + [{path: $p, kind: $k}]' <<<"$docs")
    k=$((k + 1))
  done < <(changed_paths "$fetch/pr/diff.patch")
  if [ "$k" -eq 0 ]; then
    echo "approval-queue: $pr changes no blueprint or page (a blueprint is blueprints/*.blueprint.md or .yaml, a page is docs/**/*.md outside docs/internal); queue it with the pr form" >&2
    exit 2
  fi
  if [ -n "$notes" ]; then
    unnamed=$(jq -r --argjson docs "$docs" '[.[].file] | unique - [$docs[].path] | .[]' "$notes")
    if [ -n "$unnamed" ]; then
      printf 'approval-queue: %s names files that %s does not change as a blueprint or page:\n' "$notes" "$pr" >&2
      printf '  %s\n' "$unnamed" >&2
      exit 2
    fi
  fi
  if [ -n "$replies" ]; then
    unnamed=$(jq -r --argjson docs "$docs" '[.[].anchor.file] | unique - [$docs[].path] | .[]' "$replies")
    if [ -n "$unnamed" ]; then
      printf 'approval-queue: %s has threads on files that %s does not change as a blueprint or page:\n' "$replies" "$pr" >&2
      printf '  %s\n' "$unnamed" >&2
      exit 2
    fi
  fi
  exec 8>"$root/queue.lock"
  flock 8
  other=$(waiting_item "$repo#$number")
  if [ -n "$other" ]; then
    echo "approval-queue: $repo#$number is already in the waiting item $other; decide it first" >&2
    exit 2
  fi
  mkdir -p "$item"
  mv "$fetch/pr/body.md" "$fetch/pr/pr.json" "$fetch/pr/diff.patch" "$fetch/docs" "$item/"
  printf '%s\n' "$docs" >"$item/docs.json"
  if [ -n "$notes" ]; then jq -c . "$notes" >"$item/notes.json"; else echo '[]' >"$item/notes.json"; fi
  if [ -n "$replies" ]; then jq -c . "$replies" >"$item/replies.json"; fi
  jq -n --arg id "$id" --arg repo "$repo" --arg title "$title" --argjson number "$number" --arg head "$head" \
    --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson pid "$$" --argjson pidstart "$pidstart" \
    '{id: $id, kind: "change", repo: $repo, title: $title, headline: $title, created: $created, number: $number, head: $head,
      pid: $pid, pidStart: $pidstart}' \
    >"$item/item.json.tmp"
  mv "$item/item.json.tmp" "$item/item.json"
  exec 8>&-
}

head="" file="" revises=null amends=""

# load_collected: reads the item a `collect` was asked for back into the variables the decision step reads.
# A change's item.json has no pr, so its pull request is rebuilt from the repo and number, as head_unmoved reads it.
load_collected() {
  IFS=$'\x1f' read -r kind repo file worktree pr prhead number head initiative < <(jq -r '
    [.kind, (.repo // ""), (.file // ""), (.worktree // ""), (.pr // ""), (.prHead // ""), (.number // "" | tostring), (.head // ""),
     (.initiative // "")] | join("\u001f")' "$item/item.json")
  source=$file
  if [ "$kind" = change ]; then
    pr="$repo#$number" pr_repo=$repo
  elif [ -n "$pr" ] && [[ $pr =~ ^([A-Za-z0-9._-]+/[A-Za-z0-9._-]+)#([0-9]+)$ ]]; then
    pr_repo=${BASH_REMATCH[1]} number=${BASH_REMATCH[2]}
  fi
}

# queue_item: writes the item directory for the kind, starts the app if it is down, and hands the item to
# a tab. A `collect` skips it, since its item is already queued.
queue_item() {
  case "$kind" in
    pr)
      view=$(gh pr view "$source" -R "$repo" --json body,headRefOid,number,url,headRefName,baseRefName,statusCheckRollup)
      jq -r '.body' <<<"$view" >"$check_body"
      check_brief "$check_body"
      # The lock keeps two commands from both passing the waiting-item check; item.json lands before it drops.
      exec 8>"$root/queue.lock"
      flock 8
      other=$(waiting_item "$repo#$(jq -r '.number' <<<"$view")")
      if [ -n "$other" ]; then
        echo "approval-queue: $repo#$(jq -r '.number' <<<"$view") is already in the waiting item $other; decide it first" >&2
        exit 2
      fi
      mkdir -p "$item"
      jq -r '.body' <<<"$view" >"$item/body.md"
      jq 'del(.body, .headRefOid)' <<<"$view" >"$item/pr.json"
      head=$(jq -r '.headRefOid' <<<"$view")
      number=$(jq -r '.number' <<<"$view")
      pr_diff "$repo" "$source" "$item/diff.patch"
      ;;
    design) check_brief "$source"; mkdir -p "$item"; cp "$source" "$item/doc.md"; file=$(basename "$source") ;;
    triage) check_brief "$source"; mkdir -p "$item"; cp "$source" "$item/triage.json" ;;
    packet) queue_packet ;;
    change) queue_change ;;
    blueprint | page)
      # The log names a document as <repo>:<file>, so `./x` and `x` must read as the same ref across resends.
      source=${source#./}
      check_blueprint
      if [ "$kind" = page ]; then
        check_origin
        prhead=$(pr_head "$pr_repo" "$number") || { echo "approval-queue: could not read the head of $pr" >&2; exit 1; }
      fi
      revises=$(revision_of "$(jq -nc --arg ref "$repo:$source" --arg kind "$kind" '[{ref: $ref, kind: $kind}]')")
      mkdir -p "$item"
      cp "$description" "$item/description.md"
      git -C "$worktree" cat-file blob "$blob" >"$item/doc.md"
      amends=$(amend_of "$repo:$source" "$kind")
      if [ -n "$amends" ] && git -C "$worktree" cat-file blob "$amends" >"$item/approved.md.tmp" 2>/dev/null; then
        mv "$item/approved.md.tmp" "$item/approved.md"
      else
        rm -f "$item/approved.md.tmp"
        amends=""
      fi
      if [ -n "$notes" ]; then jq -c . "$notes" >"$item/notes.json"; else echo '[]' >"$item/notes.json"; fi
      if [ -n "$replies" ]; then jq -c . "$replies" >"$item/replies.json"; fi
      jq -n --arg id "$id" --arg repo "$repo" --arg title "$title" --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg worktree "$worktree" --arg file "$source" --arg blob "$blob" --arg kind "$kind" --arg pr "$pr" --arg prhead "$prhead" --argjson revises "$revises" \
        --arg amends "$amends" --argjson pid "$$" --argjson pidstart "$pidstart" \
        '{id: $id, kind: $kind, repo: $repo, title: $title, headline: $title, created: $created,
          worktree: $worktree, file: $file, blob: $blob, pid: $pid, pidStart: $pidstart}
         + (if $pr == "" then {} else {pr: $pr, prHead: $prhead} end)
         + (if $amends == "" then {} else {amends: $amends} end)
         + (if $revises == null then {} else {revises: {item: $revises.item, revision: $revises.revision}} end)' \
        >"$item/item.json.tmp"
      mv "$item/item.json.tmp" "$item/item.json"
      ;;
  esac

  if [ "$kind" = pr ] || [ "$kind" = design ] || [ "$kind" = triage ]; then
    jq -n --arg id "$id" --arg kind "$kind" --arg repo "$repo" --arg title "$title" \
      --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg head "$head" \
      --arg number "$number" --arg file "$file" --arg headline "$headline" \
      --argjson pid "$$" --argjson pidstart "$pidstart" \
      '{id: $id, kind: $kind, repo: $repo, title: $title, created: $created, headline: $headline, pid: $pid, pidStart: $pidstart}
       + (if $head == "" then {} else {head: $head} end)
       + (if $number == "" then {} else {number: ($number | tonumber)} end)
       + (if $file == "" then {} else {file: $file} end)' >"$item/item.json.tmp"
    mv "$item/item.json.tmp" "$item/item.json"
    exec 8>&-
  fi

  exec 9>"$root/start.lock"
  flock 9
  if ! curl -sf "$base/" >/dev/null 2>&1; then
    if [ ! -e "$app/build/index.js" ]; then
      if ! (cd "$app" && npm ci && APPROVAL_QUEUE_PORT="$port" npm run build) >>"$log" 2>&1; then
        echo "approval-queue: the first build failed; see $log" >&2
        exit 1
      fi
    fi
    HOST=127.0.0.1 PORT="$port" APPROVAL_QUEUE_STATE="$root" setsid -f node "$app/build" 9>&- >>"$log" 2>&1
    up=""
    for _ in $(seq 100); do
      if curl -sf "$base/" >/dev/null 2>&1; then up=1; break; fi
      sleep 0.1
    done
    if [ -z "$up" ]; then echo "approval-queue: the app did not answer in 10 seconds; see $log" >&2; exit 1; fi
  fi

  if ! curl -sf "$base/item/$id" >/dev/null 2>&1; then
    echo "approval-queue: an app on $port does not serve this state root; stop it with pkill -f '^node $app/build'" >&2
    exit 1
  fi
  echo "approval-queue: queued $id at $base/item/$id" >&2

  # One tab serves the whole queue. An open tab polls every 2 seconds and each poll touches tab.seen,
  # so a tab.seen under 5 seconds old marks a live tab, and a poll after item.json proves it holds
  # this item. With no such poll, the command opens a tab and stamps tab.seen itself, so a command
  # waiting on the lock hands its item to that tab instead of opening another.
  seen="$root/tab.seen"
  shown=""
  if [ -n "$(find "$seen" -newermt '-5 seconds' 2>/dev/null)" ]; then
    for _ in $(seq 50); do
      if [ "$seen" -nt "$item/item.json" ]; then shown=1; break; fi
      sleep 0.1
    done
  fi
  if [ -z "$shown" ]; then
    setsid -f xdg-open "$base/item/$id" >>"$log" 2>&1
    touch "$seen"
  fi
  exec 9>&-
}

if [ -n "$collecting" ]; then
  load_collected
else
  queue_item
fi

# append_log: appends the lines on stdin to decisions.jsonl in one write under the queue lock, unless the log
# already holds a line for this item, so a decision is logged once however many commands print it. The
# log never authorizes or blocks a merge, so a failed write warns and the decision still prints.
append_log() {
  local lines
  lines=$(cat)
  [ -n "$lines" ] || return 0
  (
    flock 8
    if [ -e "$root/decisions.jsonl" ] \
      && jq -R -n -e --arg id "$id" 'any(inputs | fromjson? | objects; .packet == $id)' "$root/decisions.jsonl" >/dev/null; then
      exit 0
    fi
    printf '%s\n' "$lines" >>"$root/decisions.jsonl"
  ) 8>"$root/queue.lock" || echo "approval-queue: could not write $root/decisions.jsonl" >&2
}

# The packet decision: validates decision.json against the stored packet, joins each PR's head and
# each design's hash from the item directory, and builds the line printed on stdout plus the log lines.
# A part you did not approve never comes back approved: an ask-bound part must carry the tag of the
# choice picked, and a design whose file changed since queueing comes back hold.
decision_program=$(cat <<'JQ'
def kinds: {pr: ["approve", "hold", "send-back"], design: ["approve", "hold", "send-back"], step: ["session", "you", "skip"]};
$pk[0] as $p
| (.) as $dec
| ($p.parts | map({key: .part.ref, value: .part.kind}) | from_entries) as $kind
| ($p.asks | to_entries | map(.value + {index: (.key + 1)})) as $asks
| ($asks | map(select(.part != null) | {key: .part.ref, value: .}) | from_entries) as $bound
| ($p.routine | map({key: .part.ref, value: .verdict}) | from_entries) as $routine
| ($fx | map({key: .ref, value: (. | del(.ref))}) | from_entries) as $fact
| def partline($e; $extra):
    {time: $t, packet: $id, initiative: $ini, ref: $e.part.ref, kind: $e.part.kind, lane: $e.in}
    + (if $bound[$e.part.ref] then {rule: $bound[$e.part.ref].rule} else {} end) + $extra;
  if ($dec | type) != "object" then error("shape")
  elif $dec.decision == "reject" then
    if (($dec | keys) == ["decision", "note"] or ($dec | keys) == ["calls", "decision", "note"]) and ($dec.note | type) == "string"
      and (($dec | has("calls") | not) or ($dec.calls | type) == "array")
      and all(($dec.calls // [])[]; type == "object" and
        ((keys == ["ref", "verdict"] and (.ref | type) == "string" and (.verdict | type | IN("string", "null")))
         or (keys == ["ask", "choice", "question"] and (.ask | type) == "number" and (.question | type) == "string" and (.choice | type | IN("string", "null")))))
    then
      {out: {decision: "reject", note: $dec.note, calls: ($dec.calls // [])},
       log: [$p.parts[] | . as $e | partline($e; {verdict: "reject",
              sentBack: any(($dec.calls // [])[]; .ref? == $e.part.ref and .verdict == "send-back")}
              + ($fact[$e.part.ref] // {} | del(.changed)))]}
    else error("shape") end
  elif $dec.decision == "approve" and ($dec | keys) == ["asks", "decision", "parts"]
    and ($dec.parts | type) == "array" and ($dec.asks | type) == "array"
    and all($dec.parts[]; type == "object" and keys == ["ref", "verdict"] and (.ref | type) == "string" and (.verdict | type) == "string")
    and all($dec.asks[]; type == "object" and keys == ["choice", "index"] and (.index | type) == "number" and (.choice | type) == "string")
  then
    ($dec.parts | map({key: .ref, value: .verdict}) | from_entries) as $v
    | ($dec.asks | map({key: (.index | tostring), value: .choice}) | from_entries) as $c
    | if ([$dec.parts[].ref] | sort) != ($kind | keys) then error("refs")
      elif any($dec.parts[]; . as $x | (kinds[$kind[$x.ref]] | any(.[]; . == $x.verdict)) | not) then error("verdict")
      elif ([$dec.asks[].index] | sort) != [range(1; ($asks | length) + 1)] then error("asks")
      elif any($asks[]; . as $a | ($a.choices | any(.[]; .label == $c[$a.index | tostring])) | not) then error("choice")
      elif any($bound | to_entries[]; . as $b
          | ($b.value.choices[] | select(.label == $c[$b.value.index | tostring]) | .verdict) != $v[$b.key]) then error("tag")
      else
        [$p.parts[] | . as $e
          | $v[$e.part.ref] as $given
          | ($fact[$e.part.ref] // {}) as $f
          | (if $f.changed == true and $given == "approve" then "hold" else $given end) as $final
          | {e: $e, given: $given, final: $final, f: $f}] as $rows
        | {out: {decision: "approve",
                 parts: [$rows[] | {ref: .e.part.ref, kind: .e.part.kind, lane: .e.in, verdict: .final} + .f],
                 asks: [$asks[] | {index, part: (.part.ref // null), rule, choice: $c[.index | tostring],
                                   followed: ($c[.index | tostring] == .choices[.recommended - 1].label)}]},
           log: ([$rows[] | . as $r
                  | ($bound[$r.e.part.ref]) as $a
                  | (if $a then [$a.choices[$a.recommended - 1].label, $c[$a.index | tostring]]
                     else [$routine[$r.e.part.ref], $r.given] end) as $rc
                  | partline($r.e; {verdict: $r.final} + $r.f
                      + {recommended: $rc[0], chosen: $rc[1], overridden: ($rc[0] != $rc[1])})]
                 + [$asks[] | select(.part == null)
                    | {time: $t, packet: $id, initiative: $ini, ref: "ask:\(.index)", kind: "ask", lane: "ask", rule: .rule,
                       recommended: .choices[.recommended - 1].label, chosen: $c[.index | tostring],
                       overridden: (.choices[.recommended - 1].label != $c[.index | tostring])}])}
      end
  else error("shape") end
JQ
)

packet_decision() {
  local facts res k kind_k ref repo_k path_k queued now
  facts=$(
    jq -r '.parts | to_entries[] | .value.part as $p | [.key, $p.kind, $p.ref, ($p.repo // ""), ($p.path // "")] | join("\u001f")' "$item/packet.json" |
      while IFS=$'\x1f' read -r k kind_k ref repo_k path_k; do
        case "$kind_k" in
          pr) jq -c '{ref, head}' "$item/parts/$k/pr.json" ;;
          design)
            queued=$(jq -r '.sha256' "$item/parts/$k/doc.json")
            now=$(sha256sum "$projects/$repo_k/$path_k" 2>/dev/null | cut -d' ' -f1) || now=""
            jq -nc --arg ref "$ref" --arg q "$queued" --arg n "$now" \
              '{ref: $ref, sha256: $q} + (if $n != $q then {changed: true} else {} end)'
            ;;
        esac
      done | jq -s .
  )
  # jq runs its program once per JSON value, so a file holding none or two must be refused first.
  if [ "$(jq -s 'length' "$item/decision.json" 2>/dev/null)" != 1 ]; then
    echo "approval-queue: decision.json does not hold exactly one decision; nothing was logged" >&2
    exit 1
  fi
  if ! res=$(jq -c --slurpfile pk "$item/packet.json" --argjson fx "$facts" \
    --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg id "$id" --arg ini "$(jq -r '.initiative' "$item/item.json")" \
    "$decision_program" "$item/decision.json" 2>/dev/null); then
    echo "approval-queue: decision.json does not match the packet; nothing was logged" >&2
    exit 1
  fi
  jq -c '.log[]' <<<"$res" | append_log
  jq -c '.out' <<<"$res"
}

# single_log <ref> <kind> <verdict> <key> <value>: the pr and design kinds log one lane-single line.
single_log() {
  jq -nc --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg id "$id" --arg ref "$1" --arg kind "$2" --arg v "$3" --arg k "$4" --arg val "$5" \
    '{time: $t, packet: $id, initiative: null, ref: $ref, kind: $kind, lane: "single", verdict: $v, ($k): $val}' | append_log
}

# The comments and replies a document review's decision carries, its log line's counts of them, and the
# printed send-back, shared by doc_decision and change_decision.
carried='{comments: (.comments // []), threads: (.threads // [])}'
counts='{comments: (.comments // [] | length), replies: (.threads // [] | length)}'
sent_back='{decision: "reject", note: (.note // ""), calls: (.calls // [])} + '"$carried"

# doc_decision: a blueprint's or a page's decision. An approve names the commit the app recorded at HEAD when
# Geoff approved, and the blob is read from the worktree at that commit; a send-back names the HEAD it left.
# Both log one line keyed to the blob, with each disputed note Geoff waived and its reason and the counts of his
# comments and replies, and both print the comments and replies; a send-back also prints the calls. A page's approve
# also names its pull request and the head it was queued at, the one the screen showed, and is refused when
# the PR has moved since; its log line carries both.
doc_decision() {
  local d verdict commit bl h="" extra='{}' am
  d="$item/decision.json"
  verdict=$(jq -r '.decision // empty' "$d")
  case "$verdict" in
    approve) commit=$(jq -r '.commit // empty' "$d") ;;
    reject) commit=$(git -C "$worktree" rev-parse HEAD 2>/dev/null) || commit="" ;;
    *) echo "approval-queue: decision.json holds no approve or reject; nothing was logged" >&2; exit 1 ;;
  esac
  if [ -z "$commit" ] || ! bl=$(git -C "$worktree" rev-parse --verify --quiet "$commit:$source"); then
    echo "approval-queue: $source has no blob at ${commit:-HEAD} in $worktree; nothing was logged" >&2
    exit 1
  fi
  if [ "$kind" = page ]; then
    extra=$(jq -nc --arg pr "$pr" '{pr: $pr}')
    if [ "$verdict" = approve ]; then
      head_unmoved "$prhead"
      extra=$(jq -nc --arg pr "$pr" --arg head "$prhead" '{pr: $pr, head: $head}')
    fi
  fi
  jq -c --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg id "$id" --arg ref "$repo:$source" --arg v "$verdict" --arg kind "$kind" \
    --arg blob "$bl" --arg commit "$commit" --argjson extra "$extra" \
    '{time: $t, packet: $id, initiative: null, ref: $ref, kind: $kind, lane: "single", verdict: $v,
      blob: $blob, commit: $commit} + $extra + {waived: (.waived // [])} + '"$counts" "$d" | append_log
  # An amend review names the approved blob it was read against, in both printed shapes.
  am=$(jq -c 'if .amends then {amends: .amends} else {} end' "$item/item.json")
  if [ "$verdict" = approve ]; then
    jq -c --arg file "$source" --arg commit "$commit" --arg blob "$bl" --argjson extra "$extra" --argjson am "$am" \
      '{decision: "approve", file: $file, commit: $commit, blob: $blob} + $extra + $am + {calls: (.calls // [])} + '"$carried" "$d"
  else
    jq -c --argjson am "$am" "$sent_back"' + $am' "$d"
  fi
}

# change_decision: an approve and a send-back both name the head the change was queued at, the one its
# documents were read at, and an approve is refused when the PR has moved since. Both log one line with the
# calls Geoff answered and the counts of his comments and replies, and print the comments and replies.
change_decision() {
  local d verdict h="$head"
  d="$item/decision.json"
  verdict=$(jq -r '.decision // empty' "$d")
  case "$verdict" in
    approve) head_unmoved "$head" ;;
    reject) ;;
    *) echo "approval-queue: decision.json holds no approve or reject; nothing was logged" >&2; exit 1 ;;
  esac
  jq -c --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg id "$id" --arg ref "$repo#$number" --arg v "$verdict" --arg head "$h" \
    '{time: $t, packet: $id, initiative: null, ref: $ref, kind: "change", lane: "single", verdict: $v, head: $head}
     + (if $v == "approve" then {calls: (.calls // [])} else {} end) + '"$counts" "$d" | append_log
  if [ "$verdict" = approve ]; then
    jq -c --arg pr "$repo#$number" --arg head "$h" '{decision: "approve", pr: $pr, head: $head, calls: (.calls // [])} + '"$carried" "$d"
  else
    jq -c "$sent_back" "$d"
  fi
}

# A decision ends the wait first. A deferral ends the queuing command's wait only, since a collect waits for the decision.
while [ ! -e "$item/decision.json" ] && { [ -n "$collecting" ] || [ ! -e "$item/deferred.json" ]; }; do sleep 1; done
if [ ! -e "$item/decision.json" ]; then
  jq -nc --arg id "$id" '{decision: "defer", id: $id}'
  exit 0
fi
case "$kind" in
  packet) packet_decision ;;
  pr)
    single_log "$repo#$number" pr "$(jq -r '.decision // empty' "$item/decision.json")" head "$head"
    jq -c --arg h "$head" '. + {head: $h}' "$item/decision.json"
    ;;
  blueprint | page) doc_decision ;;
  change) change_decision ;;
  design)
    single_log "$repo:$file" design "$(jq -r '.decision // empty' "$item/decision.json")" sha256 "$(sha256sum "$item/doc.md" | cut -d' ' -f1)"
    jq -c . "$item/decision.json"
    ;;
  *) jq -c . "$item/decision.json" ;;
esac
