#!/usr/bin/env bash
# approval-queue: put one item (a design, a triage list, a packet) in front of Geoff in the Approval Queue and
# print his decision as JSON on stdout. Build, server, and browser output go to server.log.
set -euo pipefail

usage="usage: approval-queue <design|triage> <repo> <title> <source>
       approval-queue snapshot <facts.json>
       approval-queue packet [--check] [--replies <replies.json>] <initiative> <facts.json> <text.md>
       approval-queue reply <id|digest> <replies.json>
       approval-queue withdraw <id>
       approval-queue pending
       approval-queue collect <id>
       approval-queue merge [--skip <owner/repo#n>]... [--premerge-done <owner/repo#n>]... <id>
       approval-queue land <owner/repo#n> <claim>
       approval-queue digest <owner/repo#n> <claim>"
root="${XDG_STATE_HOME:-$HOME/.local/state}/approval-queue"
id_pattern='^[0-9]{8}T[0-9]{6}-[0-9]+$'

# proc_stat <pid>: prints the process's state letter and its start time in clock ticks since boot (fields 3 and
# 22 of /proc/<pid>/stat), or fails when the process is gone. The command name in field 2 can hold spaces, so
# the text is split after the last `)`.
proc_stat() {
  local s
  { read -r s <"/proc/$1/stat"; } 2>/dev/null || return 1
  s=${s##*) }
  set -- $s
  echo "$1 ${20}"
}

# proc_running <pid> <start>: succeeds when the pid is a live process that started at <start>. A reused pid has
# another start time, and a killed command its parent has not reaped is a zombie.
proc_running() {
  local st
  st=$(proc_stat "$1") || return 1
  [ "${st% *}" != Z ] && [ "${st#* }" = "$2" ]
}

# retire_item <dir>: takes an item off the board unless a decision landed. The rename is atomic, so a decision
# written before it is seen and kept (item.json goes back, return 1); one written after it is the app's to
# back off from, since the app looks for item.json again once decision.json is in place.
retire_item() {
  mv "$1/item.json" "$1/item.json.gone" 2>/dev/null || { rm -f "$1/item.json.tmp"; return 0; }
  if [ -e "$1/decision.json" ]; then
    mv "$1/item.json.gone" "$1/item.json"
    return 1
  fi
  rm -f "$1/item.json.gone" "$1/item.json.tmp"
}

# withdraw <id>: takes a waiting item off the board. It writes a withdrawn marker, then sends a live waiter TERM,
# and the waiter's exit trap retires item.json only when it finds the marker. A dead waiter leaves the file for
# withdraw to retire. A TERM from anywhere else (a reboot) leaves the item for `collect` (#59).
if [ "${1:-}" = withdraw ]; then
  shift
  if [ $# -ne 1 ]; then echo "$usage" >&2; exit 2; fi
  wdir="$root/items/$1"
  if [[ ! $1 =~ $id_pattern ]]; then echo "approval-queue: $1 is not an item id" >&2; exit 2; fi
  if [ ! -e "$wdir/item.json" ]; then echo "approval-queue: no item $1 is queued" >&2; exit 2; fi
  if [ -e "$wdir/decision.json" ]; then echo "approval-queue: $1 is decided; collect it instead" >&2; exit 2; fi
  wpid=$(jq -r '.pid // empty' "$wdir/item.json")
  wstart=$(jq -r '.pidStart // empty' "$wdir/item.json")
  if [ -z "$wpid" ]; then echo "approval-queue: $1 was queued before withdraw existed; stop its command" >&2; exit 2; fi
  if proc_running "$wpid" "$wstart"; then
    : >"$wdir/withdrawn"
    kill -TERM "$wpid" 2>/dev/null || true
    # Wait for the waiter to exit, not for item.json to vanish: retire_item's rename makes it vanish briefly.
    for _ in $(seq 50); do
      proc_running "$wpid" "$wstart" || break
      sleep 0.1
    done
    if proc_running "$wpid" "$wstart"; then
      echo "approval-queue: $1 is still queued after its command was told to stop" >&2
      exit 1
    fi
    [ -e "$wdir/item.json" ] || { echo "withdrew $1"; exit 0; }
  fi
  # The waiter is gone and its trap kept the item (or never ran): retire it here, unless a decision landed.
  retire_item "$wdir" && { echo "withdrew $1"; exit 0; }
  echo "approval-queue: $1 was decided while withdrawing; run collect" >&2
  exit 1
fi

# unanswered <notes file> <replies file>: prints how many notes (the `notes` array of a decision, or the array a
# file holds) no reply in the replies file (when it exists) answers.
unanswered() {
  local replies='[]'
  [ ! -e "$2" ] || replies=$(cat "$2")
  jq -r --argjson r "$replies" '(if type == "array" then . else .notes // [] end) as $n
    | [$n[] | select(((.text // "x") | gsub("[[:space:]]"; "")) != "") | .id | tostring] - [$r[] | .note | tostring] | length' "$1"
}

# pending: prints one line per decided item no command is left to log: `<id>\t<kind>\t<decision>\t<title>`,
# oldest first, for a session to `collect`; then `<id>\tnotes\t<count>\t<title>` for each decided packet with notes
# no reply answers, and `digest\tdigest-notes\t<count>\t-` for digest notes no reply answers. Skipped: an item with a live waiter, a logged decision (a log line
# whose `packet` is the item's id), a triage item (its decision is never logged), a kind this queue no longer
# reads, and an item queued before pids existed, which cannot be told from a handled one.
if [ "${1:-}" = pending ]; then
  shift
  if [ $# -ne 0 ]; then echo "$usage" >&2; exit 2; fi
  logged=""
  if [ -e "$root/decisions.jsonl" ]; then
    logged=$(jq -R -r 'fromjson? | objects | .packet // empty | strings' "$root/decisions.jsonl")
  fi
  for pdir in "$root"/items/*/; do
    pdir=${pdir%/}
    [ -e "$pdir/item.json" ] && [ -e "$pdir/decision.json" ] || continue
    IFS=$'\x1f' read -r ppid pstart pkind ptitle < <(jq -r '
      [(.pid // "" | tostring), (.pidStart // "" | tostring), .kind, (.title | gsub("[\t\n]"; " "))] | join("\u001f")' "$pdir/item.json") || continue
    [ -n "$ppid" ] || continue
    case "$pkind" in design | packet) ;; *) continue ;; esac
    ! proc_running "$ppid" "$pstart" || continue
    pitem=${pdir##*/}
    ! grep -qxF -- "$pitem" <<<"$logged" || continue
    printf '%s\t%s\t%s\t%s\n' "$pitem" "$pkind" "$(jq -r '.decision // empty' "$pdir/decision.json")" "$ptitle"
  done
  # Notes no reply answers: each decided packet's, then the digest's.
  for pdir in "$root"/items/*/; do
    pdir=${pdir%/}
    [ -e "$pdir/item.json" ] && [ -e "$pdir/decision.json" ] && [ -e "$pdir/facts.json" ] || continue
    pcount=$(unanswered "$pdir/decision.json" "$pdir/replies.json")
    [ "$pcount" -eq 0 ] || printf '%s\tnotes\t%s\t%s\n' "${pdir##*/}" "$pcount" "$(jq -r '.title | gsub("[\t\n]"; " ")' "$pdir/item.json")"
  done
  if [ -e "$root/digest-notes.json" ]; then
    pcount=$(unanswered "$root/digest-notes.json" "$root/digest-replies.json")
    [ "$pcount" -eq 0 ] || printf 'digest\tdigest-notes\t%s\t-\n' "$pcount"
  fi
  exit 0
fi

# refuse <message>: one line on stderr, exit 2.
refuse() {
  echo "approval-queue: $1" >&2
  exit 2
}

ref_pattern='^[^/#[:space:]]+/[^/#[:space:]]+#[0-9]+$'

# view_pr <ref> <fields>: prints the PR's `gh pr view` JSON for the fields; a gh failure prints gh's error and exits 1.
view_pr() {
  local errf out rc=0
  errf=$(mktemp)
  out=$(gh pr view "${1##*#}" --repo "${1%#*}" --json "$2" 2>"$errf" </dev/null) || rc=$?
  if [ "$rc" -ne 0 ]; then
    cat "$errf" >&2
    rm -f "$errf"
    exit 1
  fi
  rm -f "$errf"
  printf '%s\n' "$out"
}

# merge_pr <ref> <head>: merges at the head; a gh failure prints gh's error and returns 1.
merge_pr() {
  gh pr merge "${1##*#}" --repo "${1%#*}" --merge --match-head-commit "$2" </dev/null
}

has_before_merge() { grep -qiE '^##[[:space:]]+Before merge[[:space:]]*$' <<<"$1"; }

# rollup_failing <view json> and rollup_pending <view json>: succeed when a check in the view's statusCheckRollup
# has failed, or is not finished. `land` and `packet` share them, and the figures below.
rollup_failing() {
  jq -e 'any(.statusCheckRollup[]?; ((.conclusion // "") | . != "" and (IN("SUCCESS", "NEUTRAL", "SKIPPED") | not)) or ((.state // "") | IN("FAILURE", "ERROR")))' <<<"$1" >/dev/null
}
rollup_pending() {
  jq -e 'any(.statusCheckRollup[]?; (.status != null and .status != "COMPLETED") or .state == "PENDING")' <<<"$1" >/dev/null
}
# The pending-check wait: poll every 30 seconds for up to 15 minutes. The overrides are for tests only.
check_poll=${APPROVAL_QUEUE_POLL_S:-30} check_cap=${APPROVAL_QUEUE_POLL_MAX_S:-900}

# pr_diff <owner/repo#n> <file>: saves the PR's diff into file. GitHub refuses a diff of more than 300 files (HTTP
# 406, too_large), so that refusal falls back to the PR's file list, which carries each file's patch for up to 3,000
# files; a rename with no content change has no patch. A diff with terminal escape sequences is refused until
# --allow-escape-sequences, so that refusal is retried with the flag and the control bytes other than tab and
# newline are removed from what is stored (#61).
pr_diff() {
  local r=${1%#*} n=${1##*#} out=$2 err
  if err=$(gh pr diff "$n" -R "$r" 2>&1 >"$out" </dev/null); then return 0; fi
  case $err in
    *'terminal escape sequences'*)
      if err=$(gh pr diff "$n" -R "$r" --allow-escape-sequences 2>&1 >"$out.raw" </dev/null); then
        LC_ALL=C tr -d '\000-\010\013-\037' <"$out.raw" >"$out"
        rm -f "$out.raw"
        return 0
      fi
      rm -f "$out.raw"
      printf '%s\n' "$err" >&2
      return 1 ;;
    *too_large*) ;;
    *) printf '%s\n' "$err" >&2; return 1 ;;
  esac
  gh api --paginate "repos/$r/pulls/$n/files?per_page=100" </dev/null | jq -rs '
    add | .[] | (.previous_filename // .filename) as $old
    | "diff --git a/\($old) b/\(.filename)",
      (if .status == "renamed" then "rename from \($old)", "rename to \(.filename)" else empty end),
      (if .patch then "--- a/\($old)", "+++ b/\(.filename)", .patch else empty end)' >"$out"
}

# snapshot <facts.json>: writes snapshot/ beside the fact file, one patch per PR and heads.json. Each patch must be
# the diff of the head it pins, so a head that moved while fetching is fetched again, and a third move exits 1.
if [ "${1:-}" = snapshot ]; then
  shift
  if [ $# -ne 1 ]; then echo "$usage" >&2; exit 2; fi
  jq -e '(.prs | type) == "array" and all(.prs[]; type == "string")' "$1" >/dev/null 2>&1 \
    || refuse "$1 is not a fact file with a list of prs (the approval-packet skill)"
  sdir=$(dirname "$1")/snapshot
  stmp=$(mktemp -d "$(dirname "$1")/.snapshot.XXXXXX")
  trap 'rm -rf "$stmp"' EXIT
  heads='[]'
  while IFS= read -r sref; do
    [[ $sref =~ $ref_pattern ]] || refuse "$sref is not a pull request as owner/repo#n (the approval-packet skill)"
    sname=${sref/\#/-}
    shead=""
    for _ in 1 2 3; do
      first=$(view_pr "$sref" headRefOid | jq -r '.headRefOid')
      pr_diff "$sref" "$stmp/${sname//\//-}.patch" || exit 1
      shead=$(view_pr "$sref" headRefOid | jq -r '.headRefOid')
      [ "$shead" != "$first" ] || break
      shead=""
    done
    [ -n "$shead" ] || { echo "approval-queue: $sref moved its head three times while it was fetched; try again" >&2; exit 1; }
    heads=$(jq -c --arg r "$sref" --arg h "$shead" '. + [{ref: $r, head: $h}]' <<<"$heads")
  done < <(jq -r '.prs[]' "$1")
  printf '%s\n' "$heads" >"$stmp/heads.json"
  rm -rf "$sdir"
  mv "$stmp" "$sdir"
  echo "approval-queue: snapshotted $(jq length <<<"$heads") pull requests into $sdir" >&2
  exit 0
fi

# replies_defects <replies.json> <note ids json>: prints a line for each defect of a replies file: an array of
# {note, outcome, text, ref} that answers notes in the id list, with a ref (a commit or a backlog item) for fixed
# and filed.
replies_defects() {
  jq -e . "$1" >/dev/null 2>&1 || { echo "$1 is not JSON"; return 0; }
  jq -r --argjson ids "$2" '
    if type != "array" then "the replies file must hold an array of {note, outcome, text, ref}"
    else to_entries[] | (.key + 1) as $n | .value as $r
      | if ($r | type) != "object" then "reply \($n) is not an object"
        elif (($r | keys) - ["note", "outcome", "text", "ref"] | length) > 0 then "reply \($n) holds a key beyond note, outcome, text, and ref"
        elif ($r.note | type | IN("string", "number") | not) or ($ids | index([($r.note | tostring)]) == null) then "reply \($n) answers a note this item does not have"
        elif ($r.outcome | IN("fixed", "filed", "answered") | not) then "reply \($n) has the outcome \($r.outcome | tojson); it is fixed, filed, or answered"
        elif ($r.text | type) != "string" or ($r.text | test("^\\s*$")) then "reply \($n) has no text"
        elif ($r | has("ref")) and (($r.ref | type) != "string" or ($r.ref | test("^\\s*$"))) then "reply \($n) has a ref that is not a commit or a backlog item"
        elif ($r.outcome | IN("fixed", "filed")) and (($r.ref // "") == "") then "reply \($n) is \($r.outcome) and needs a ref (a commit or a backlog item)"
        else empty end
    end' "$1"
}

# store_replies <replies.json> <dest>: merges the replies into dest, a later reply to a note replacing an earlier.
store_replies() {
  local old='[]'
  [ ! -e "$2" ] || old=$(cat "$2")
  jq -c --argjson old "$old" '(map(.note | tostring)) as $n
    | ($old | map(select((.note | tostring) as $x | ($n | index([$x])) == null))) + .' "$1" >"$2.tmp"
  mv "$2.tmp" "$2"
}

# reply <id|digest> <replies.json>: stores replies on a decided item, or on the digest's notes.
if [ "${1:-}" = reply ]; then
  shift
  if [ $# -ne 2 ]; then echo "$usage" >&2; exit 2; fi
  [ -r "$2" ] || { echo "approval-queue: cannot read $2" >&2; exit 1; }
  if [ "$1" = digest ]; then
    [ -e "$root/digest-notes.json" ] || refuse "the digest holds no notes"
    rids=$(jq -c '[.[] | .id | tostring]' "$root/digest-notes.json")
    rdest="$root/digest-replies.json"
  else
    [[ $1 =~ $id_pattern ]] || refuse "$1 is not an item id"
    rdir="$root/items/$1"
    [ -e "$rdir/item.json" ] || refuse "no item $1 is queued"
    [ -e "$rdir/decision.json" ] || refuse "$1 is not decided yet"
    [ -e "$rdir/facts.json" ] || refuse "$1 was queued in an old shape and holds no notes to answer"
    rids=$(jq -c '[(.notes // [])[] | .id | tostring]' "$rdir/decision.json")
    rdest="$rdir/replies.json"
  fi
  rdefects=$(replies_defects "$2" "$rids")
  [ -z "$rdefects" ] || refuse "$rdefects (the approval-packet skill)"
  store_replies "$2" "$rdest"
  exit 0
fi

# merge <id>: merges each PR of a decided approve, in heads.json order, and records each success in merged.json.
if [ "${1:-}" = merge ]; then
  shift
  skips=() dones=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --skip | --premerge-done)
        [ $# -ge 2 ] && [[ $2 =~ $ref_pattern ]] || { echo "$usage" >&2; exit 2; }
        if [ "$1" = --skip ]; then skips+=("$2"); else dones+=("$2"); fi
        shift 2 ;;
      *) break ;;
    esac
  done
  if [ $# -ne 1 ]; then echo "$usage" >&2; exit 2; fi
  [[ $1 =~ $id_pattern ]] || refuse "$1 is not an item id"
  mdir="$root/items/$1"
  [ -e "$mdir/item.json" ] || refuse "no item $1 is queued"
  if [ -e "$mdir/design.json" ] || [ ! -e "$mdir/heads.json" ]; then refuse "$1 has no pull requests to merge"; fi
  [ -e "$mdir/decision.json" ] || refuse "$1 is not decided yet"
  [ "$(jq -r '.decision' "$mdir/decision.json")" = approve ] || refuse "$1 was not approved"
  [ ! -e "$mdir/stale.json" ] || refuse "$1 is out of date: a head moved since it was queued"
  [ -e "$mdir/merged.json" ] || echo '[]' >"$mdir/merged.json"
  merged=() failed=() skipped=() notreached=()
  mapfile -t mrefs < <(jq -r '.[].ref' "$mdir/heads.json")
  # merge_report: prints the one-line summary.
  merge_report() {
    jq -nc --argjson m "$(jq -nc '$ARGS.positional' --args "${merged[@]}")" --argjson f "$(jq -nc '$ARGS.positional' --args "${failed[@]}")" \
      --argjson s "$(jq -nc '$ARGS.positional' --args "${skipped[@]}")" --argjson n "$(jq -nc '$ARGS.positional' --args "${notreached[@]}")" \
      '{merged: $m, failed: $f, skipped: $s, notReached: $n}'
  }
  stopped_at=""
  for mref in "${mrefs[@]}"; do
    if printf '%s\n' "${skips[@]}" | grep -qxF -- "$mref"; then skipped+=("$mref"); continue; fi
    if [ -n "$stopped_at" ]; then notreached+=("$mref"); continue; fi
    mhead=$(jq -r --arg r "$mref" '.[] | select(.ref == $r) | .head' "$mdir/heads.json")
    mview=$(view_pr "$mref" state,headRefOid,body) || { failed+=("$mref"); stopped_at=$mref; continue; }
    if [ "$(jq -r '.state' <<<"$mview")" = MERGED ] && [ "$(jq -r '.headRefOid' <<<"$mview")" = "$mhead" ]; then
      :
    else
      mbody=$(jq -r '.body // ""' <<<"$mview")
      if has_before_merge "$mbody" && ! printf '%s\n' "${dones[@]}" | grep -qxF -- "$mref"; then
        echo "approval-queue: $mref has a Before merge section; do it, then pass --premerge-done $mref" >&2
        awk 'tolower($0) ~ /^##[ \t]+before merge/ {on = 1; print; next} /^##[ \t]/ {on = 0} on' <<<"$mbody"
        exit 2
      fi
      merge_pr "$mref" "$mhead" || { failed+=("$mref"); stopped_at=$mref; continue; }
    fi
    if ! jq -e --arg r "$mref" 'any(.[]; .ref == $r)' "$mdir/merged.json" >/dev/null; then
      jq --arg r "$mref" --arg h "$mhead" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '. + [{ref: $r, head: $h, at: $t}]' "$mdir/merged.json" >"$mdir/merged.json.tmp"
      mv "$mdir/merged.json.tmp" "$mdir/merged.json"
    fi
    merged+=("$mref")
  done
  merge_report
  [ -z "$stopped_at" ] || exit 1
  exit 0
fi

# digest_line <ref> <head> <claim> <lane>: appends one line to digest.jsonl.
digest_line() {
  mkdir -p "$root"
  jq -nc --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg r "$1" --arg h "$2" --arg c "$3" --arg l "$4" \
    '{time: $t, ref: $r, head: $h, claim: $c, lane: $l}' >>"$root/digest.jsonl"
}

# land <ref> <claim>: merges a small PR the session judged, once its checks are not failing, at the head it read.
if [ "${1:-}" = land ]; then
  shift
  if [ $# -ne 2 ] || [[ ! $1 =~ $ref_pattern ]]; then echo "$usage" >&2; exit 2; fi
  lref=$1 lclaim=$2
  for lf in "$root"/items/*/item.json; do
    [ -e "$lf" ] && [ ! -e "$(dirname "$lf")/decision.json" ] || continue
    if jq -e --arg r "$lref" '(.refs // []) | index($r)' "$lf" >/dev/null 2>&1 \
      || { [ -e "$(dirname "$lf")/heads.json" ] && jq -e --arg r "$lref" 'any(.[]; .ref == $r)' "$(dirname "$lf")/heads.json" >/dev/null 2>&1; }; then
      refuse "$lref is in the waiting item $(basename "$(dirname "$lf")"); decide it first"
    fi
  done
  waited=0
  while :; do
    lview=$(view_pr "$lref" state,headRefOid,body,statusCheckRollup)
    [ "$(jq -r '.state' <<<"$lview")" = OPEN ] || refuse "$lref is $(jq -r '.state' <<<"$lview"), not open"
    has_before_merge "$(jq -r '.body // ""' <<<"$lview")" && refuse "$lref has a Before merge section; send it in a packet"
    ! rollup_failing "$lview" || refuse "$lref has a failing check"
    rollup_pending "$lview" || break
    [ "$waited" -lt "$check_cap" ] || refuse "$lref still has checks pending after ${check_cap}s"
    sleep "$check_poll"
    waited=$((waited + check_poll))
  done
  lhead=$(jq -r '.headRefOid' <<<"$lview")
  merge_pr "$lref" "$lhead" || exit 1
  digest_line "$lref" "$lhead" "$lclaim" land
  exit 0
fi

# digest <ref> <claim>: records a PR already merged or closed by hand.
if [ "${1:-}" = digest ]; then
  shift
  if [ $# -ne 2 ] || [[ ! $1 =~ $ref_pattern ]]; then echo "$usage" >&2; exit 2; fi
  dview=$(view_pr "$1" state,headRefOid)
  [ "$(jq -r '.state' <<<"$dview")" != OPEN ] || refuse "$1 is still open; land it or send it in a packet"
  digest_line "$1" "$(jq -r '.headRefOid' <<<"$dview")" "$2" record
  exit 0
fi

# The retired forms exit 2, each naming its replacement.
case "${1:-}" in
  docs | notes)
    echo "approval-queue: the $1 form is retired; put a review in a packet, where Geoff's notes anchor to any text (the approval-packet skill)" >&2
    exit 2 ;;
  pr)
    echo "approval-queue: the pr form is retired; send the pull request in a packet (the approval-packet skill), or merge a small one with approval-queue land" >&2
    exit 2 ;;
esac

collecting="" check="" replies_file="" initiative="" repo="" title="" source="" facts_file="" text_file="" file=""
if [ "${1:-}" = collect ]; then
  shift
  if [ $# -ne 1 ]; then echo "$usage" >&2; exit 2; fi
  if [[ ! $1 =~ $id_pattern ]]; then echo "approval-queue: $1 is not an item id" >&2; exit 2; fi
  if [ ! -e "$root/items/$1/item.json" ]; then echo "approval-queue: no item $1 is queued" >&2; exit 2; fi
  ckind=$(jq -r '.kind' "$root/items/$1/item.json")
  case "$ckind" in design | triage | packet) ;; *) echo "approval-queue: $1 is a $ckind item, which this queue no longer reads" >&2; exit 2 ;; esac
  if [ "$ckind" = packet ] && [ ! -e "$root/items/$1/facts.json" ]; then
    echo "approval-queue: $1 was queued in an old shape, which this queue no longer reads" >&2
    exit 2
  fi
  kind=collect collecting=$1
elif [ "${1:-}" = packet ]; then
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1; shift ;;
      --replies)
        [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }
        replies_file=$2
        shift 2 ;;
      *) break ;;
    esac
  done
  if [ $# -eq 2 ]; then refuse "the one-file packet form is retired; write a fact file and a text file and pass both (the approval-packet skill)"; fi
  if [ $# -ne 3 ]; then echo "$usage" >&2; exit 2; fi
  kind=packet initiative=$1 facts_file=$2 text_file=$3
else
  if [ $# -ne 4 ]; then echo "$usage" >&2; exit 2; fi
  kind=$1 repo=$2 title=$3 source=$4
  case "$kind" in design | triage) ;; *) echo "$usage" >&2; exit 2 ;; esac
fi

log="$root/server.log"
id="$(date +%Y%m%dT%H%M%S)-$$"
[ -z "$collecting" ] || id=$collecting
item="$root/items/$id"
# The pid and its start time let the board and `withdraw` tell this command from a process that reused its pid.
pidstart=$(proc_stat "$$" | cut -d' ' -f2)
fetch="$root/fetch-$id"
# The port is fixed when the app is built, so a running app serves only the port it was built with.
port="${APPROVAL_QUEUE_PORT:-7907}"
base="http://127.0.0.1:$port"
projects="${APPROVAL_QUEUE_PROJECTS:-$HOME/Projects}"
mkdir -p "$root"
: >>"$log"

# One pair per invocation: a PR hand-over and a triage hand-over run side by side. Assigned before the traps
# so a TERM in between does not meet an unbound variable.
check_body="$root/check-$id.md"
check_err="$root/check-$id.err"

# A command that fails without a decision takes its item off the index. A stop signal (a reboot, a closed
# terminal) leaves it for `collect`, unless `withdraw` wrote its marker first (#59). The trap never fails: under
# set -e a failing last command would turn the exit status to 1.
stopped=""
if [ -n "$collecting" ]; then
  # A collect never takes the item off the board, however it ends.
  trap 'rm -f "$check_body" "$check_err"; rm -rf "$fetch"' EXIT
else
  trap '[ -e "$item/decision.json" ] || { [ -n "$stopped" ] && [ ! -e "$item/withdrawn" ]; } || retire_item "$item" || true; rm -f "$check_body" "$check_err"; rm -rf "$fetch"' EXIT
fi
trap 'stopped=1; exit 143' TERM HUP INT

app=$(realpath "$(dirname "$(realpath "$0")")/../../../approval-queue")


# check_brief <file>: refuses (exit 2) an item whose brief is missing or incomplete, before any
# item directory exists, and sets headline. Anything else that fails is a tool failure (exit 1).
headline=""
check_brief() {
  local out rc=0
  out=$(node "$app/src/check-brief.ts" "$kind" "$1" 2>"$check_err") || rc=$?
  if [ "$rc" -ne 0 ]; then
    cat "$check_err" >&2
    [ "$rc" -eq 2 ] || echo "approval-queue: the brief check failed to run" >&2
    exit "$((rc == 2 ? 2 : 1))"
  fi
  headline=$(jq -r '.headline' <<<"$out")
}


# refuse_packet <defect>: prints the defect, logs {time, initiative, defect} to refusals.jsonl, exit 2.
refuse_packet() {
  printf '%s\n' "$1" >&2
  jq -nc --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg i "$initiative" --arg d "$1" \
    '{time: $t, initiative: $i, defect: $d}' >>"$root/refusals.jsonl"
  exit 2
}

# waiting_item <ref>: prints the id of a waiting item (one with an item.json and no decision.json)
# that holds the PR.
waiting_item() {
  local f d
  for f in "$root"/items/*/item.json; do
    d=$(dirname "$f")
    [ -e "$f" ] && [ ! -e "$d/decision.json" ] && [ -e "$d/heads.json" ] || continue
    if jq -e --arg ref "$1" 'any(.[]; .ref == $ref)' "$d/heads.json" >/dev/null; then basename "$d"; fi
  done | head -n 1
}

# check_waiting <ref>...: prints a defect for each ref a waiting item already holds.
check_waiting() {
  local ref other
  for ref in "$@"; do
    other=$(waiting_item "$ref")
    [ -z "$other" ] || echo "$ref is already in the waiting item $other; decide it first"
  done
}

# sent_back <prs json> <design key>: prints null, or {item, revision} when the latest decided item that holds any
# of the pull requests, or the design (as repo:path), was sent back. The revision is one more than that item's.
# Items are ordered by the time their decision was written.
sent_back() {
  local d f latest="" decided=()
  mapfile -t decided < <(ls -1tr -- "$root"/items/*/decision.json 2>/dev/null)
  for f in "${decided[@]}"; do
    d=$(dirname "$f")
    [ -e "$d/item.json" ] && [ -e "$d/facts.json" ] || continue
    jq -e --argjson prs "$1" --arg dk "$2" '
      (.prs // []) as $mine | (.design // null) as $dsg
      | any($mine[]; . as $x | ($prs | index([$x])) != null)
        or ($dk != "" and $dsg != null and "\($dsg.repo):\($dsg.path)" == $dk)' "$d/facts.json" >/dev/null || continue
    latest=$d
  done
  if [ -n "$latest" ] && [ "$(jq -r '.decision' "$latest/decision.json")" = reject ]; then
    jq -nc --arg i "${latest##*/}" --argjson r "$(jq '(.revises.revision // 1) + 1' "$latest/item.json")" '{item: $i, revision: $r}'
  else
    echo null
  fi
}

# rank_of <path>: prints where a file sorts in the packet's file list (the global `held` holds the fact file's
# globs): held paths 0, workflows 1, configuration 2, other files 3, tests 4, generated files 5.
rank_of() {
  local p=$1 g
  for g in "${held[@]}"; do
    # shellcheck disable=SC2053
    if [[ $p == $g ]]; then echo 0; return 0; fi
  done
  case $p in
    .github/workflows/*) echo 1 ;;
    *package-lock.json | *yarn.lock | *pnpm-lock.yaml | *.lock | *go.sum | *.snap | *.min.js | dist/* | build/* | */generated/* | generated/*) echo 5 ;;
    package.json | */package.json | *.config.* | .*rc | *.yml | *.yaml | *.toml | tsconfig*.json | Makefile | Dockerfile) echo 2 ;;
    *.test.* | *.spec.* | *_test.* | test/* | tests/* | */test/* | */tests/* | */__tests__/*) echo 4 ;;
    *) echo 3 ;;
  esac
}

# queue_packet: checks the fact file and text against the snapshot, reads each PR (waiting for pending checks),
# and writes the item directory, item.json last. With --check it stops before writing anything. Leaves the lock
# released.
queue_packet() {
  local rc=0 k ref pinned view st waited ranks prev="" have ids missing rdefects dkey="" dsrc="" snapdir checked="$fetch/checked.json"
  local revises prs=() held=() defects=()
  if [ "$initiative" != none ]; then
    [[ $initiative =~ ^[a-z0-9-]+$ && -e "$projects/initiatives/$initiative/initiative.yaml" ]] \
      || refuse_packet "the initiative is none or the id of a record: no initiatives/$initiative/initiative.yaml under $projects (the approval-packet skill)"
  fi
  [ -r "$facts_file" ] && [ -r "$text_file" ] && { [ -z "$replies_file" ] || [ -r "$replies_file" ]; } \
    || { echo "approval-queue: cannot read $facts_file, $text_file, or $replies_file" >&2; exit 1; }
  jq -e . "$facts_file" >/dev/null 2>&1 \
    || refuse_packet "$facts_file is not JSON: the one-file packet grammar is retired; write a fact file and a text file (the approval-packet skill)"
  snapdir=$(dirname "$facts_file")/snapshot
  if [ "$(jq 'try (.prs | length) catch 0' "$facts_file")" -gt 0 ] && [ ! -e "$snapdir/heads.json" ]; then
    refuse_packet "no snapshot beside $facts_file; run approval-queue snapshot $facts_file first (the approval-packet skill)"
  fi
  mkdir -p "$fetch/prs"
  node "$app/src/check-brief.ts" facts "$facts_file" "$text_file" "$snapdir" >"$checked" 2>"$check_err" || rc=$?
  if [ "$rc" -ne 0 ]; then
    [ "$rc" -eq 2 ] && refuse_packet "$(cat "$check_err")"
    cat "$check_err" >&2
    echo "approval-queue: the packet check failed to run" >&2
    exit 1
  fi
  mapfile -t prs < <(jq -r '.facts.prs[]' "$checked")
  mapfile -t held < <(jq -r '.facts.held[]' "$checked")
  if [ "${#prs[@]}" -gt 0 ]; then
    jq -e --argjson prs "$(jq -c '.facts.prs' "$checked")" '([.[].ref] | sort) == ($prs | sort)' "$snapdir/heads.json" >/dev/null \
      || refuse_packet "the snapshot holds other pull requests than the fact file's prs; run approval-queue snapshot again (the approval-packet skill)"
  fi
  if jq -e '.facts.design' "$checked" >/dev/null; then
    dkey=$(jq -r '.facts.design | "\(.repo):\(.path)"' "$checked")
    dsrc="$projects/$(jq -r '.facts.design.repo' "$checked")/$(jq -r '.facts.design.path' "$checked")"
    [ -r "$dsrc" ] || refuse_packet "the design $dkey is not at $dsrc (the approval-packet skill)"
  fi

  # A resend of an item Geoff sent back answers each of its notes.
  revises=$(sent_back "$(jq -c '.facts.prs' "$checked")" "$dkey")
  if [ "$revises" != null ]; then
    prev="$root/items/$(jq -r '.item' <<<"$revises")"
    ids=$(jq -c '[(.notes // [])[] | .id | tostring]' "$prev/decision.json")
    have='[]'
    if [ -n "$replies_file" ]; then
      rdefects=$(replies_defects "$replies_file" "$ids")
      [ -z "$rdefects" ] || refuse_packet "$rdefects (the approval-packet skill)"
      have=$(jq -c '[.[] | .note | tostring]' "$replies_file")
    fi
    [ ! -e "$prev/replies.json" ] || have=$(jq -c --argjson h "$have" '$h + [.[] | .note | tostring]' "$prev/replies.json")
    missing=$(jq -nr --argjson ids "$ids" --argjson h "$have" '$ids - $h | join(", ")')
    [ -z "$missing" ] || refuse_packet "this packet resends the item $(jq -r '.item' <<<"$revises") that you sent back, and leaves its notes $missing unanswered; pass --replies with a reply to each (the approval-packet skill)"
  elif [ -n "$replies_file" ]; then
    refuse_packet "--replies answers an item that was sent back, and no item holding these pull requests was (the approval-packet skill)"
  fi

  mapfile -t defects < <(check_waiting "${prs[@]}")
  for k in "${!prs[@]}"; do
    ref=${prs[k]}
    pinned=$(jq -r --arg r "$ref" '.[] | select(.ref == $r) | .head' "$snapdir/heads.json")
    waited=0
    while :; do
      view=$(view_pr "$ref" state,headRefOid,title,body,statusCheckRollup,files)
      if [ "$(jq -r '.state' <<<"$view")" != OPEN ]; then
        defects+=("$ref is $(jq -r '.state' <<<"$view"); a merged or closed pull request cannot be queued")
        continue 2
      fi
      if [ "$(jq -r '.headRefOid' <<<"$view")" != "$pinned" ]; then
        defects+=("$ref moved to $(jq -r '.headRefOid[:7]' <<<"$view") since the snapshot at ${pinned:0:7}; run approval-queue snapshot again")
        continue 2
      fi
      # A failing check refuses at once; a pending one is waited for, except under --check.
      rollup_failing "$view" && break
      rollup_pending "$view" || break
      if [ -n "$check" ]; then
        defects+=("$ref has checks still pending; wait for the checks to finish")
        continue 2
      fi
      if [ "$waited" -ge "$check_cap" ]; then
        defects+=("$ref still has checks pending after ${check_cap}s")
        continue 2
      fi
      sleep "$check_poll"
      waited=$((waited + check_poll))
    done
    jq -r '.body // ""' <<<"$view" >"$fetch/body-$k.md"
    jq '{state, statusCheckRollup}' <<<"$view" >"$fetch/pr-$k.json"
    st=$(node "$app/src/check-pr.ts" "$fetch/pr-$k.json" "$fetch/body-$k.md") \
      || { echo "approval-queue: the pull request check failed to run for $ref" >&2; exit 1; }
    if { rollup_failing "$view" || jq -e '.verdict == "fix" or .verdict == "escalate"' <<<"$st" >/dev/null; } \
      && ! jq -e '.facts.calls | any(.forced and .rule == "gate-failed")' "$checked" >/dev/null; then
      defects+=("$ref has a failing check or a review verdict of fix or escalate; that is a forced call with the rule gate-failed")
    fi
    if jq -e '.beforeMerge' <<<"$st" >/dev/null && ! jq -e '.facts.calls | any(.forced)' "$checked" >/dev/null; then
      defects+=("$ref has a Before merge section; that is a forced call")
    fi
    ranks=$(jq -r '(.files // [])[].path' <<<"$view" | while IFS= read -r p; do rank_of "$p"; done | jq -sc .)
    jq --arg ref "$ref" --argjson ranks "$ranks" '
      def row: if .__typename == "StatusContext"
        then {name: (.context // ""), bucket: (if .state == "SUCCESS" then "pass" elif (.state == "PENDING" or .state == "EXPECTED") then "pending" else "fail" end)}
        else {name: (if (.workflowName // "") != "" then "\(.workflowName) / \(.name)" else (.name // "") end),
              bucket: (if .status != "COMPLETED" then "pending" elif (.conclusion == "SUCCESS" or .conclusion == "NEUTRAL") then "pass" elif .conclusion == "SKIPPED" then "skipping" else "fail" end)}
        end;
      {ref: $ref, title: (.title // ""), body: (.body // ""), checks: [(.statusCheckRollup // [])[] | row],
       files: ([(.files // []), $ranks] | transpose | map((.[0] + {rank: .[1]}) | {path, additions, deletions, rank}) | sort_by(.rank))}' \
      <<<"$view" >"$fetch/prs/$k.json"
  done
  if [ "${#defects[@]}" -gt 0 ]; then
    refuse_packet "$(printf '%s\n' "${defects[@]}" | sed 's/$/ (the approval-packet skill)/')"
  fi
  if [ -n "$check" ]; then exit 0; fi

  exec 8>"$root/queue.lock"
  flock 8
  mapfile -t defects < <(check_waiting "${prs[@]}")
  [ "${#defects[@]}" -eq 0 ] || refuse_packet "$(printf '%s\n' "${defects[@]}")"
  mkdir -p "$item"
  cp "$facts_file" "$item/facts.json"
  cp "$text_file" "$item/text.md"
  if [ -d "$snapdir" ]; then cp -r "$snapdir" "$item/snapshot"; fi
  if [ "${#prs[@]}" -gt 0 ]; then
    jq -c --argjson prs "$(jq -c '.facts.prs' "$checked")" '. as $h | [$prs[] | . as $r | $h[] | select(.ref == $r)]' "$snapdir/heads.json" >"$item/heads.json"
    mv "$fetch/prs" "$item/prs"
  fi
  if [ -n "$dsrc" ]; then
    cp "$dsrc" "$item/design.md"
    jq -n --arg sha "$(sha256sum "$item/design.md" | cut -d' ' -f1)" '{sha256: $sha}' >"$item/design.json"
  fi
  [ -z "$replies_file" ] || store_replies "$replies_file" "$prev/replies.json"
  jq -n --arg id "$id" --arg initiative "$initiative" --arg title "$(jq -r '.facts.title' "$checked")" \
    --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson revises "$revises" --argjson pid "$$" --argjson pidstart "$pidstart" \
    '{id: $id, kind: "packet", title: $title, initiative: $initiative, created: $created, pid: $pid, pidStart: $pidstart}
     + (if $revises == null then {} else {revises: $revises} end)' >"$item/item.json.tmp"
  mv "$item/item.json.tmp" "$item/item.json"
  exec 8>&-
}

# pr_head <owner/repo> <n>: prints the PR's head commit, asking three times; returns 1 when gh cannot say.
pr_head() {
  local out try
  for try in 1 2 3; do
    if out=$(gh pr view "$2" -R "$1" --json headRefOid </dev/null 2>/dev/null) && out=$(jq -er '.headRefOid' <<<"$out" 2>/dev/null); then
      printf '%s\n' "$out"
      return 0
    fi
    sleep 1
  done
  return 1
}

# load_collected: reads the item a `collect` was asked for back into the variables the decision step reads.
load_collected() {
  IFS=$'\x1f' read -r kind repo file < <(jq -r '[.kind, (.repo // ""), (.file // "")] | join("\u001f")' "$item/item.json")
}

# queue_item: writes the item directory for the kind, starts the app if it is down, and hands the item to
# a tab. A `collect` skips it, since its item is already queued.
queue_item() {
  case "$kind" in
    design) check_brief "$source"; mkdir -p "$item"; cp "$source" "$item/doc.md"; file=$(basename "$source") ;;
    triage) check_brief "$source"; mkdir -p "$item"; cp "$source" "$item/triage.json" ;;
    packet) queue_packet ;;
  esac

  if [ "$kind" = design ] || [ "$kind" = triage ]; then
    jq -n --arg id "$id" --arg kind "$kind" --arg repo "$repo" --arg title "$title" \
      --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg file "$file" --arg headline "$headline" \
      --argjson pid "$$" --argjson pidstart "$pidstart" \
      '{id: $id, kind: $kind, repo: $repo, title: $title, created: $created, headline: $headline, pid: $pid, pidStart: $pidstart}
       + (if $file == "" then {} else {file: $file} end)' >"$item/item.json.tmp"
    mv "$item/item.json.tmp" "$item/item.json"
    exec 8>&-
  fi

  exec 9>"$root/start.lock"
  flock 9
  if ! curl -sf "$base/" >/dev/null 2>&1; then
    if [ ! -e "$app/build/index.js" ]; then
      if ! (cd "$app" && npm ci && APPROVAL_QUEUE_PORT="$port" npm run build) >>"$log" 2>&1; then
        echo "approval-queue: the first build failed; see $log" >&2
        exit 1
      fi
    fi
    HOST=127.0.0.1 PORT="$port" APPROVAL_QUEUE_STATE="$root" setsid -f node "$app/build" 9>&- >>"$log" 2>&1
    up=""
    for _ in $(seq 100); do
      if curl -sf "$base/" >/dev/null 2>&1; then up=1; break; fi
      sleep 0.1
    done
    if [ -z "$up" ]; then echo "approval-queue: the app did not answer in 10 seconds; see $log" >&2; exit 1; fi
  fi

  if ! curl -sf "$base/item/$id" >/dev/null 2>&1; then
    echo "approval-queue: an app on $port does not serve this state root; stop it with pkill -f '^node $app/build'" >&2
    exit 1
  fi
  echo "approval-queue: queued $id at $base/item/$id" >&2

  # One tab serves the whole queue. An open tab polls every 2 seconds and each poll touches tab.seen,
  # so a tab.seen under 5 seconds old marks a live tab, and a poll after item.json proves it holds
  # this item. With no such poll, the command opens a tab and stamps tab.seen itself, so a command
  # waiting on the lock hands its item to that tab instead of opening another.
  seen="$root/tab.seen"
  shown=""
  if [ -n "$(find "$seen" -newermt '-5 seconds' 2>/dev/null)" ]; then
    for _ in $(seq 50); do
      if [ "$seen" -nt "$item/item.json" ]; then shown=1; break; fi
      sleep 0.1
    done
  fi
  if [ -z "$shown" ]; then
    setsid -f xdg-open "$base/item/$id" >>"$log" 2>&1
    touch "$seen"
  fi
  exec 9>&-
}

if [ -n "$collecting" ]; then
  load_collected
else
  queue_item
fi

# append_log: appends the lines on stdin to decisions.jsonl in one write under the queue lock, unless the log
# already holds a line for this item, so a decision is logged once however many commands print it. The
# log never authorizes or blocks a merge, so a failed write warns and the decision still prints.
append_log() {
  local lines
  lines=$(cat)
  [ -n "$lines" ] || return 0
  (
    flock 8
    if [ -e "$root/decisions.jsonl" ] \
      && jq -R -n -e --arg id "$id" 'any(inputs | fromjson? | objects; .packet == $id)' "$root/decisions.jsonl" >/dev/null; then
      exit 0
    fi
    printf '%s\n' "$lines" >>"$root/decisions.jsonl"
  ) 8>"$root/queue.lock" || echo "approval-queue: could not write $root/decisions.jsonl" >&2
}


# The packet decision: joins each PR's pinned head (or the design's hash) from the item directory onto decision.json,
# and prints it, then logs one line. The server checked the decision's shape against the packet when it was posted.
packet_decision() {
  local parts res
  # jq runs its program once per JSON value, so a file holding none or two must be refused first.
  if [ "$(jq -s 'length' "$item/decision.json" 2>/dev/null)" != 1 ]; then
    echo "approval-queue: decision.json does not hold exactly one decision; nothing was logged" >&2
    exit 1
  fi
  jq -e 'type == "object" and (.decision | IN("approve", "reject")) and (.calls | type) == "array"
    and (.decidedForYou | type) == "array" and (.notes | type) == "array"' "$item/decision.json" >/dev/null 2>&1 \
    || { echo "approval-queue: decision.json does not match the packet; nothing was logged" >&2; exit 1; }
  if [ -e "$item/design.json" ]; then
    parts=$(jq -c --arg k "$(jq -r '.design | "\(.repo):\(.path)"' "$item/facts.json")" '[{ref: $k, sha256: .sha256}]' "$item/design.json")
  else
    parts=$(jq -c . "$item/heads.json")
  fi
  res=$(jq -c --argjson parts "$parts" '. + {parts: $parts}' "$item/decision.json")
  jq -c --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg id "$id" --arg ini "$(jq -r '.initiative' "$item/item.json")" \
    --arg k "$(jq -r '.kind' "$item/facts.json")" \
    '{time: $t, packet: $id, initiative: $ini, kind: $k, decision, calls, decidedForYou, notes: (.notes | length), parts}' <<<"$res" | append_log
  printf '%s\n' "$res"
}

# single_log <ref> <kind> <verdict> <key> <value>: the design kind logs one lane-single line.
single_log() {
  jq -nc --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg id "$id" --arg ref "$1" --arg kind "$2" --arg v "$3" --arg k "$4" --arg val "$5" \
    '{time: $t, packet: $id, initiative: null, ref: $ref, kind: $kind, lane: "single", verdict: $v, ($k): $val}' | append_log
}

# stale_poll: writes stale.json {ref, queued, now} when a pinned head, or the design's hash, differs from what
# was queued. A gh failure is skipped; the next poll asks again.
stale_poll() {
  local ref head now dkey found
  [ ! -e "$item/stale.json" ] || return 0
  if [ -e "$item/design.json" ]; then
    dkey=$(jq -r '.design | "\(.repo):\(.path)"' "$item/facts.json")
    now=$(sha256sum "$projects/$(jq -r '.design.repo' "$item/facts.json")/$(jq -r '.design.path' "$item/facts.json")" 2>/dev/null | cut -d' ' -f1) || now=""
    head=$(jq -r '.sha256' "$item/design.json")
    ref=$dkey
    [ -n "$now" ] && [ "$now" != "$head" ] || return 0
  else
    found=""
    while IFS=$'\x1f' read -r ref head; do
      now=$(pr_head "${ref%#*}" "${ref##*#}") || continue
      [ "$now" != "$head" ] || continue
      found=1
      break
    done < <(jq -r '.[] | [.ref, .head] | join("\u001f")' "$item/heads.json")
    [ -n "$found" ] || return 0
  fi
  jq -nc --arg r "$ref" --arg q "$head" --arg n "$now" '{ref: $r, queued: $q, now: $n}' >"$item/stale.json.tmp"
  mv "$item/stale.json.tmp" "$item/stale.json"
}

# A decision ends the wait. So does item.json going away: a withdraw has taken the item off the board, and
# nothing will decide it. A packet's wait also polls its heads (or its design file) every 60 seconds.
stale_every=${APPROVAL_QUEUE_POLL_S:-60}
stale_next=$((SECONDS + stale_every))
while [ ! -e "$item/decision.json" ] && [ -e "$item/item.json" ]; do
  sleep 1
  if [ "$kind" = packet ] && [ "$SECONDS" -ge "$stale_next" ]; then
    stale_poll
    stale_next=$((SECONDS + stale_every))
  fi
done
if [ ! -e "$item/decision.json" ]; then
  echo "approval-queue: $id was withdrawn; nothing to collect" >&2
  exit 1
fi
case "$kind" in
  packet) packet_decision ;;
  design)
    single_log "$repo:$file" design "$(jq -r '.decision // empty' "$item/decision.json")" sha256 "$(sha256sum "$item/doc.md" | cut -d' ' -f1)"
    jq -c . "$item/decision.json"
    ;;
  *) jq -c . "$item/decision.json" ;;
esac
