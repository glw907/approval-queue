#!/usr/bin/env bash
# approval-queue: the Approval Queue's command. Runs the TypeScript command in this checkout's
# approval-queue/ folder. realpath resolves the install link, because `restart` knows the running
# server by this checkout's real path.
set -euo pipefail
here="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
exec node "$here/../../../approval-queue/cli/index.js" "$@"
