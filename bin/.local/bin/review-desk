#!/usr/bin/env bash
# review-desk: put one item (a PR, a design, a triage list) in front of Geoff in the review desk app
# and print his decision as JSON on stdout. Build, server, and Firefox output go to server.log.
set -euo pipefail

usage="usage: review-desk <pr|design|triage> <repo> <title> <source>"
if [ $# -ne 4 ]; then echo "$usage" >&2; exit 2; fi
kind=$1 repo=$2 title=$3 source=$4
case "$kind" in pr | design | triage) ;; *) echo "$usage" >&2; exit 2 ;; esac

root="${XDG_STATE_HOME:-$HOME/.local/state}/review-desk"
log="$root/server.log"
id="$(date +%Y%m%dT%H%M%S)-$$"
item="$root/items/$id"
base="http://127.0.0.1:7907"
mkdir -p "$item"
: >>"$log"

# A command that leaves without a decision takes its item off the index.
trap '[ -e "$item/decision.json" ] || rm -f "$item/item.json" "$item/item.json.tmp"' EXIT
trap 'exit 143' TERM HUP INT

head="" number="" file=""
case "$kind" in
  pr)
    view=$(gh pr view "$source" -R "$repo" --json body,headRefOid,number,url,headRefName,baseRefName,statusCheckRollup)
    jq -r '.body' <<<"$view" >"$item/body.md"
    jq 'del(.body, .headRefOid)' <<<"$view" >"$item/pr.json"
    head=$(jq -r '.headRefOid' <<<"$view")
    number=$(jq -r '.number' <<<"$view")
    gh pr diff "$source" -R "$repo" >"$item/diff.patch"
    ;;
  design) cp "$source" "$item/doc.md"; file=$(basename "$source") ;;
  triage) cp "$source" "$item/triage.json" ;;
esac

jq -n --arg id "$id" --arg kind "$kind" --arg repo "$repo" --arg title "$title" \
  --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg head "$head" \
  --arg number "$number" --arg file "$file" \
  '{id: $id, kind: $kind, repo: $repo, title: $title, created: $created}
   + (if $head == "" then {} else {head: $head} end)
   + (if $number == "" then {} else {number: ($number | tonumber)} end)
   + (if $file == "" then {} else {file: $file} end)' >"$item/item.json.tmp"
mv "$item/item.json.tmp" "$item/item.json"

app=$(realpath "$(dirname "$(realpath "$0")")/../../../review-desk")

exec 9>"$root/start.lock"
flock 9
if ! curl -sf "$base/" >/dev/null 2>&1; then
  if [ ! -e "$app/build/index.js" ]; then
    if ! (cd "$app" && npm ci && npm run build) >>"$log" 2>&1; then
      echo "review-desk: the first build failed; see $log" >&2
      exit 1
    fi
  fi
  HOST=127.0.0.1 PORT=7907 REVIEW_DESK_STATE="$root" setsid -f node "$app/build" 9>&- >>"$log" 2>&1
  up=""
  for _ in $(seq 100); do
    if curl -sf "$base/" >/dev/null 2>&1; then up=1; break; fi
    sleep 0.1
  done
  if [ -z "$up" ]; then echo "review-desk: the app did not answer in 10 seconds; see $log" >&2; exit 1; fi
fi
exec 9>&-

if ! curl -sf "$base/item/$id" >/dev/null 2>&1; then
  echo "review-desk: an app on 7907 does not serve this state root; stop it with pkill -f 'review-desk/[b]uild'" >&2
  exit 1
fi

setsid -f firefox --new-tab "$base/item/$id" >>"$log" 2>&1

while [ ! -e "$item/decision.json" ]; do sleep 1; done
if [ "$kind" = pr ]; then
  jq -c --arg h "$head" '. + {head: $h}' "$item/decision.json"
else
  jq -c . "$item/decision.json"
fi
