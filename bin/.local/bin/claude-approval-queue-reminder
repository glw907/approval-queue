#!/usr/bin/env python3
"""PostToolUse hook telling the session to put a PR it just opened in the Approval Queue.

The approval hand-over lived only in pass-core's Close section, so a PR opened outside a pass missed
it. After a Bash call whose command runs `gh pr create`, the hook finds the new PR's URL in the
tool response and returns `hookSpecificOutput.additionalContext` naming the packet hand-over
for that PR (https://code.claude.com/docs/en/hooks, "PostToolUse decision control"). Every input
the script cannot parse, and every call that opened no PR, exits 0 silently.
"""

import json
import re
import sys

PREFILTER = re.compile(r"gh\s+pr\s+create")
PR_URL = re.compile(r"https://github\.com/([\w.-]+/[\w.-]+)/pull/(\d+)")
CONTEXT = (
    "You opened PR #{number} in {repo}. Put it in your hand-over packet for Geoff's Approval Queue "
    "through the `approval-packet` skill: it names the PR by its ref `{repo}#{number}` and hands the packet "
    "over with `approval-queue packet <initiative> <file>`, then waits for the decision it prints as JSON. "
    "On an approve, merge each approved PR with `gh pr merge <number> --repo <repo> --merge "
    "--match-head-commit <head>`, taking <head> from that part of the decision, each as its own Bash command. "
    "The PR body must open with a `## Brief` written to ~/.claude/docs/voice/approval-brief.md; "
    "the command refuses a PR without one. Skip the approval queue only where pass-core's Close says the PR "
    "is not yours to hand over: an executor whose launch prompt gives the hand-over to the conductor, or an "
    "ordinary-class pass that merges its own PR."
)


def main() -> int:
    """Read the hook input and return the exit code."""
    try:
        data = json.load(sys.stdin)
        command = (data.get("tool_input") or {}).get("command")
        response = json.dumps(data.get("tool_response"))
    except (ValueError, AttributeError, TypeError):
        return 0
    if not isinstance(command, str) or not PREFILTER.search(command):
        return 0
    found = PR_URL.search(response)
    if found is None:
        return 0
    repo, number = found.groups()
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PostToolUse",
        "additionalContext": CONTEXT.format(repo=repo, number=number),
    }}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
