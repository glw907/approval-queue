#!/usr/bin/env python3
"""PostToolUse hook that reminds a session where a PR it just opened goes.

After a Bash call with a `gh pr create` stage, the hook finds the new PR's URL in the tool response
and returns `hookSpecificOutput.additionalContext` with one line
(https://code.claude.com/docs/en/hooks, "PostToolUse decision control"). Every input the script
cannot parse, and every call that opened no PR, exits 0 silently. A command that only mentions
`gh pr create` inside a quoted argument, such as an `echo`, is not a stage and stays silent.
"""

import json
import re
import shlex
import sys

PR_URL = re.compile(r"https://github\.com/([\w.-]+/[\w.-]+)/pull/(\d+)")
STAGE_BREAK = {"&&", "||", ";", "|", "&", "(", ")"}
CONTEXT = (
    "PR #{number} in {repo} goes to Geoff in the pass's close packet, or lands with "
    "`approval-queue land` if it has no call, no auth-data path, and no `## Before merge` step."
)


def has_create_stage(command: str) -> bool:
    """Whether a stage of the command, split on shell operators, runs `gh pr create`."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    stage: list[str] = []
    try:
        tokens = list(lexer)
    except ValueError:
        return False
    for token in tokens + [";"]:
        if token in STAGE_BREAK:
            while stage and re.fullmatch(r"[A-Za-z_]\w*=.*", stage[0]):
                stage.pop(0)
            if stage[:3] == ["gh", "pr", "create"]:
                return True
            stage = []
        else:
            stage.append(token)
    return False


def main() -> int:
    """Read the hook input and return the exit code."""
    try:
        data = json.load(sys.stdin)
        command = (data.get("tool_input") or {}).get("command")
        response = json.dumps(data.get("tool_response"))
    except (ValueError, AttributeError, TypeError):
        return 0
    if not isinstance(command, str) or not has_create_stage(command):
        return 0
    found = PR_URL.search(response)
    if found is None:
        return 0
    repo, number = found.groups()
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PostToolUse",
        "additionalContext": CONTEXT.format(repo=repo, number=number),
    }}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
