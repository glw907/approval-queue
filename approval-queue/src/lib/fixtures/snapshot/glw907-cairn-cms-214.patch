+++ b/.github/workflows/publish.yml
@@ -25,6 +34,10 @@
       promote:
         type: string
-        required: true
+        required: false
+      snapshot:
+        description: A dev snapshot version to publish to the gate dist-tag; dispatch on main
+        type: string
+        required: false
 
 jobs:
   ci-green:
@@ -36,5 +49,14 @@
   ci-green:
-    if: github.event_name == 'release'
